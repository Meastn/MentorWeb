---
/* REF: MG-2026-ASTRO-EN-ADVISORY-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Initial Advisory Session";
const pageDesc = "Official case intake and scoping consultation portal for company formation, investment incentives, and relocation coordination in Türkiye.";

// Scope Table Content
const scopeInclusions = [
  'Detailed scoping of the investment intent, timeline, and entity parameters',
  'Identification of eligible government support and tax reduction brackets',
  'Listing corresponding regulatory, operational, or legal pathways',
  'Highlighting immediate documentation, bank setup, and credential requirements',
  'Defining structural roadmap options for the subsequent partner coordination phase'
];

const scopeExclusions = [
  'No final binding legal, tax, accounting, or citizenship guarantees',
  'No definitive pre-approvals on government incentive outcomes',
  'No deep-level commercial feasibility or full fiscal audit review',
  'No formal file preparation or tescil registrations executed during the 30-min call',
  'Subsequent desk work, document drafting, or administrative filings are handled separately'
];
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <!-- 01. OFFICIAL INTAKE DOSSIER HEADER -->
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-EN-ADVISORY</span>
          <span class="classification-stamp">[ CLASSIFICATION: MANDATORY / INTAKE ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">05. INITIAL ADVISORY SESSION</span>
          <h1 class="hero-main-title">Dossier Scoping & Case Intake</h1>
          <p class="hero-subtitle">Before confirming your 30-minute strategic consultation with our managing partner, you are required to review the service scope and submit your operational parameters below.</p>
          <hr class="double-rule" />
        </div>

        <!-- 02. INCLUSIONS & EXCLUSIONS TABLE MATRIX -->
        <div class="matrix-box mb-xl">
          <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-md);">Session Scope & Administrative Boundaries</h3>
          <table class="matrix-table">
            <thead>
              <tr>
                <th style="width: 50%;">01. WHAT THE ADVISORY SESSION INCLUDES</th>
                <th style="width: 50%;">02. WHAT THE ADVISORY SESSION DOES NOT INCLUDE</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="vertical-align: top;">
                  <ul class="matrix-list inclusion-list">
                    {scopeInclusions.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
                <td style="vertical-align: top;">
                  <ul class="matrix-list exclusion-list">
                    {scopeExclusions.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 03. CASE INTAKE MULTI-STEP FLOW -->
        <div class="flow-wizard-container" id="advisory-flow-wizard">
          
          <!-- Wizard Steps Navigator -->
          <div class="wizard-nav">
            <div class="w-step active" data-nav="form">1. DETAILED DOSSIER INTAKE</div>
            <div class="w-step-divider">&rarr;</div>
            <div class="w-step" data-nav="summary">2. AI ANALYTICAL BRIEF</div>
            <div class="w-step-divider">&rarr;</div>
            <div class="w-step" data-nav="stripe">3. PROCESSING FEE (€150)</div>
            <div class="w-step-divider">&rarr;</div>
            <div class="w-step" data-nav="calendar">4. CALENDAR SCHEDULER</div>
          </div>

          <div class="double-rule" style="margin: 15px 0;"></div>

          <!-- STAGE 1: Intake Form -->
          <div class="wizard-panel active" id="wizard-panel-form">
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: var(--space-md);">Corporate Dossier Submission Form</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: var(--space-lg);">To ensure high-value session scoping, please fill out all operational fields. Your corporate information is protected under GDPR and formal confidentiality protocols.</p>

            <form id="intake-form" class="retro-form">
              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Full name -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="full_name">Full Name (as per Passport/ID)*</label>
                  <input type="text" id="full_name" class="form-control" placeholder="e.g. John Doe" required />
                </div>
                <!-- Email -->
                <div class="form-group">
                  <label class="form-label" for="email">Corporate Email Address*</label>
                  <input type="email" id="email" class="form-control" placeholder="e.g. john@yourfirm.com" required />
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Phone -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="phone">Phone / WhatsApp Coordinates*</label>
                  <input type="text" id="phone" class="form-control" placeholder="e.g. +1 (555) 019-2834" required />
                </div>
                <!-- Country -->
                <div class="form-group">
                  <label class="form-label" for="country">Country of Residence*</label>
                  <input type="text" id="country" class="form-control" placeholder="e.g. United Kingdom" required />
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Company name -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="company_name">Company Name (if applicable)</label>
                  <input type="text" id="company_name" class="form-control" placeholder="e.g. Global Tech Ltd." />
                </div>
                <!-- Company country -->
                <div class="form-group">
                  <label class="form-label" for="company_country">Company Jurisdiction / Headquarters</label>
                  <input type="text" id="company_country" class="form-control" placeholder="e.g. United States" />
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Preferred lang -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="pref_lang">Preferred Session Language*</label>
                  <select id="pref_lang" class="form-control" required>
                    <option value="en">English</option>
                    <option value="tr">Türkçe</option>
                  </select>
                </div>
                <!-- Main topic -->
                <div class="form-group">
                  <label class="form-label" for="main_topic">Advisory Focus Category*</label>
                  <select id="main_topic" class="form-control" required>
                    <option value="relocate">Invest & Relocate (Market Entry / Setup / Relocation)</option>
                    <option value="incentive">Investment Incentives & Government Supports</option>
                    <option value="formation">Company Formation & Tescil Setup</option>
                    <option value="compliance">Regulatory & Compliance Clearance</option>
                  </select>
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Has company in TR -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="has_tr_company">Do You Already Have an Established Entity in Türkiye?*</label>
                  <select id="has_tr_company" class="form-control" required>
                    <option value="no">No, we plan to establish a new entity</option>
                    <option value="yes">Yes, we have an active Turkish subsidiary</option>
                  </select>
                </div>
                <!-- Investment type -->
                <div class="form-group">
                  <label class="form-label" for="investment_type">Investment Classification*</label>
                  <select id="investment_type" class="form-control" required>
                    <option value="new">New (Greenfield) Domestic Investment</option>
                    <option value="expansion">Expansion of Existing Infrastructure</option>
                    <option value="relocate_only">Corporate Relocation & Structural Alignment Only</option>
                  </select>
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Sector -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="sector">Industry / Operational Sector*</label>
                  <input type="text" id="sector" class="form-control" placeholder="e.g. Manufacturing, SaaS, Energy" required />
                </div>
                <!-- Budget -->
                <div class="form-group">
                  <label class="form-label" for="budget_range">Estimated Capital Investment Scale*</label>
                  <select id="budget_range" class="form-control" required>
                    <option value="under5">Under €150,000 / 5M TRY</option>
                    <option value="5to50">€150,000 - €1,500,000 / 5M - 50M TRY</option>
                    <option value="over50">Over €1,500,000 / > 50M TRY</option>
                  </select>
                </div>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Timeline -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="timeline_range">Target Execution Timeline*</label>
                  <select id="timeline_range" class="form-control" required>
                    <option value="immediate">Immediate Scoping (0-3 Months)</option>
                    <option value="mid">Strategic Planning (3-6 Months)</option>
                    <option value="feasibility">Feasibility & Scoping Phase</option>
                  </select>
                </div>
                <!-- Official applications before -->
                <div class="form-group">
                  <label class="form-label" for="prev_app">Have You Submitted Any Prior Official Applications in Türkiye?*</label>
                  <select id="prev_app" class="form-control" required>
                    <option value="no">No, this is our initial dossier filing</option>
                    <option value="yes">Yes, we have pending/prior administrative filings</option>
                  </select>
                </div>
              </div>

              <!-- Describe in detail -->
              <div class="form-group mb-md">
                <label class="form-label" for="case_detail">Please Describe Your Case & Objectives in Detail*</label>
                <textarea id="case_detail" class="form-control" rows="5" placeholder="Provide background on your commercial objectives, specific support needs, or regulatory hurdles you wish to address..." required></textarea>
              </div>

              <div class="ledger-row ledger-row-2col" style="margin-bottom: var(--space-md); border: none;">
                <!-- Decision trying to make -->
                <div class="form-group" style="padding-right: var(--space-md);">
                  <label class="form-label" for="decision_making">What Primary Decision are You Trying to Resolve?*</label>
                  <input type="text" id="decision_making" class="form-control" placeholder="e.g. Scoping tax incentives, determining setup timelines" required />
                </div>
                <!-- Useful session goals -->
                <div class="form-group">
                  <label class="form-label" for="session_usefulness">What Would Make this Session Most Useful for You?*</label>
                  <input type="text" id="session_usefulness" class="form-control" placeholder="e.g. Actionable regulatory timeline, list of requirements" required />
                </div>
              </div>

              <!-- File upload placeholder -->
              <div class="form-group mb-md">
                <label class="form-label">Company Dossier / Presentation Slide Deck (Optional PDF)</label>
                <div class="file-upload-box">
                  <span class="file-icon">&#128196;</span>
                  <span class="file-text">Drag and drop or click here to attach your PDF dossier briefing</span>
                  <input type="file" id="file_placeholder" class="file-input" accept=".pdf,.doc,.docx" />
                </div>
              </div>

              <!-- Consent checkboxes -->
              <div class="form-group mb-lg">
                <label class="checkbox-label">
                  <input type="checkbox" class="checkbox-input" required />
                  <span>
                    I confirm that I have reviewed the <a href="/en/privacy/" target="_blank" style="text-decoration: underline; color: var(--color-primary-green);">Privacy & GDPR Statement</a> and consent to the processing of my corporate dossier parameters for intake scoping.*
                  </span>
                </label>
                <br /><br />
                <label class="checkbox-label">
                  <input type="checkbox" class="checkbox-input" required />
                  <span>
                    I have read and agree to the <a href="/en/advisory/terms/" target="_blank" style="text-decoration: underline; color: var(--color-primary-green);">Advisory Session Terms and Conditions</a>, understanding that this preliminary session does not provide final sovereign guarantees.*
                  </span>
                </label>
              </div>

              <div class="text-right">
                <button type="submit" class="btn btn-primary" style="font-size: 1rem; padding: 12px 32px;">GENERATE BRIEF & PROCEED TO PAYMENT</button>
              </div>
            </form>
          </div>

          <!-- STAGE 2: AI Summary Generation (Typewriter/ledger briefing) -->
          <div class="wizard-panel" id="wizard-panel-summary">
            <div class="ai-generation-box">
              <span class="ref-stamp" style="color: var(--color-burgundy);">INTELLIGENT SCORING ACTIVE</span>
              <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-top: 5px;">AI Dossier Analytical Summary</h3>
              <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">The Case Intake Agent (Gemini) is compiling your structural dossier executive brief...</p>
              
              <div class="ai-brief-dossier" id="ai-brief-output">
                <!-- Dynamic AI Typing -->
                <div class="typing-placeholder">CONSTRUCTING DOSSIER BRIEF...</div>
              </div>

              <div class="step-actions mt-lg" id="ai-next-actions" style="display: none;">
                <button type="button" class="btn btn-burgundy" id="ai-to-stripe-btn">LOCK DOSSIER & PROCEED TO STRIPE CLEARANCE (€150)</button>
              </div>
            </div>
          </div>

          <!-- STAGE 3: Stripe Mock checkout -->
          <div class="wizard-panel" id="wizard-panel-stripe">
            <div class="stripe-mock-box">
              <div class="stripe-header">
                <span>Stripe Secure Gateway</span>
                <span class="secure-icon">&#128274;</span>
              </div>
              <div class="stripe-body">
                <h4 style="font-family: var(--font-sans); text-transform: uppercase; font-size: 0.75rem; color: var(--color-text-muted);">ORDER OVERVIEW</h4>
                <div class="stripe-price-line">
                  <span class="stripe-item-name">Initial Advisory Intake Processing & 30-Min Session Fee</span>
                  <span class="stripe-price">150.00 €</span>
                </div>
                
                <hr class="double-rule" style="margin: 15px 0;" />
                
                <div class="stripe-card-inputs">
                  <div class="form-group">
                    <label class="form-label" style="font-size: 0.65rem;">CARD NUMBER</label>
                    <input type="text" class="form-control" value="4242 4242 4242 4242" placeholder="4242 4242 4242 4242" disabled />
                  </div>
                  <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
                    <div class="form-group" style="padding-right: var(--space-md);">
                      <label class="form-label" style="font-size: 0.65rem;">EXPIRY DATE (MM/YY)</label>
                      <input type="text" class="form-control" value="12 / 29" placeholder="12/29" disabled />
                    </div>
                    <div class="form-group">
                      <label class="form-label" style="font-size: 0.65rem;">CVC</label>
                      <input type="text" class="form-control" value="424" placeholder="424" disabled />
                    </div>
                  </div>
                </div>

                <button type="button" class="btn btn-primary w-full" id="stripe-pay-btn" style="background-color: #635bff; border-color: #635bff; margin-top: 20px; font-weight: 600;">
                  SUBMIT HARC FEE (€150.00)
                </button>
              </div>
            </div>
          </div>

          <!-- STAGE 4: Google Calendar booking slots -->
          <div class="wizard-panel" id="wizard-panel-calendar">
            <div class="calendar-booking-box">
              <span class="ref-stamp">[ STEP 4: SCHEDULE DOSSIER REVIEW ]</span>
              <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-top: 5px;">Strategic Advisory Calendar</h3>
              <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">Your intake harc processing cleared successfully. Please confirm your preferred 30-minute calendar slot below to lock in the Google Meet executive session coordinates.</p>
              
              <div class="calendar-layout-grid">
                <!-- Day Select -->
                <div class="calendar-days-col">
                  <span class="form-label">AVAILABLE DATES</span>
                  <div class="days-list">
                    <button type="button" class="day-select-btn active" data-day="June 01, 2026">Monday, June 01, 2026</button>
                    <button type="button" class="day-select-btn" data-day="June 02, 2026">Tuesday, June 02, 2026</button>
                    <button type="button" class="day-select-btn" data-day="June 03, 2026">Wednesday, June 03, 2026</button>
                    <button type="button" class="day-select-btn" data-day="June 04, 2026">Thursday, June 04, 2026</button>
                  </div>
                </div>
                <!-- Time slots -->
                <div class="calendar-slots-col">
                  <span class="form-label">AVAILABLE HOURS (TÜRKİYE TIME)</span>
                  <div class="slots-grid">
                    <button type="button" class="slot-select-btn" data-time="10:00 AM - 10:30 AM">10:00 AM - 10:30 AM</button>
                    <button type="button" class="slot-select-btn" data-time="11:30 AM - 12:00 PM">11:30 AM - 12:00 PM</button>
                    <button type="button" class="slot-select-btn" data-time="02:00 PM - 02:30 PM">02:00 PM - 02:30 PM</button>
                    <button type="button" class="slot-select-btn" data-time="04:00 PM - 04:30 PM">04:00 PM - 04:30 PM</button>
                  </div>
                </div>
              </div>

              <div class="double-rule" style="margin: 20px 0;"></div>

              <div class="text-right">
                <button type="button" class="btn btn-primary" id="confirm-booking-btn" style="display: none;">CONFIRM DOSSIER REVIEW & INITIALIZE MEET LINK</button>
              </div>
            </div>
          </div>

          <!-- SUCCESS PORTAL PAGE (RECEIPT PRINT OUT) -->
          <div class="wizard-panel" id="wizard-panel-success">
            <div class="success-receipt-box">
              <div class="receipt-border-top"></div>
              <div class="receipt-body">
                <span class="ref-stamp" style="color: var(--color-primary-green);">OFFICIAL ADVISORY BOOKING RECEIPT</span>
                <h2 style="font-family: var(--font-serif); font-size: 1.8rem; margin-top: 5px; color: var(--color-primary-green);">DOSSIER SECURED & CONSTITUTED</h2>
                <div class="double-rule" style="margin: 15px 0;"></div>
                
                <div class="receipt-grid">
                  <div class="receipt-row-data"><strong>Client Name:</strong> <span id="r-name">John Doe</span></div>
                  <div class="receipt-row-data"><strong>Dossier Ref:</strong> <span id="r-ref">MG-REQ-20260531-A</span></div>
                  <div class="receipt-row-data"><strong>Session Date & Time:</strong> <span id="r-datetime">June 01, 2026 | 02:00 PM - 02:30 PM (Turkey Time)</span></div>
                  <div class="receipt-row-data"><strong>Executive Officer:</strong> <span>Mentor Group Senior Advisory Partner</span></div>
                  <div class="receipt-row-data"><strong>Google Meet Coordinate:</strong> <a href="https://meet.google.com/abc-defg-hij" target="_blank" class="meet-link" style="color: var(--color-primary-green); text-decoration: underline;">meet.google.com/abc-defg-hij</a></div>
                  <div class="receipt-row-data"><strong>Processing Fee:</strong> <span>150.00 € (Settled via Stripe)</span></div>
                </div>
                
                <div class="boundaries-banner" style="margin-top: 20px;">
                  <span class="boundaries-stamp">[ REGULATORY NOTICE ]</span>
                  <p class="boundaries-text" style="font-size: 0.72rem;">Your AI-generated analytical dossier brief has been validated and committed to our secure server database. The corresponding calendar invitation, Google Meet coordinates, and fiscal receipt have been dispatched to your corporate email. Please join the Meet coordinate 5 minutes prior to your slot.</p>
                </div>

                <div class="text-center" style="margin-top: 25px;">
                  <a href="/en/" class="btn btn-secondary">RETURN TO MAIN DOSSIER</a>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .dossier-box {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-xl);
  }

  .dossier-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-line-muted);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .classification-stamp {
    font-family: monospace;
    font-size: var(--size-meta);
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .hero-title-box {
    margin-bottom: var(--space-xl);
  }

  .hero-main-title {
    font-size: 2.8rem;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--size-body-large);
    color: var(--color-text-muted);
    max-width: 800px;
    line-height: 1.6;
  }

  /* Matrix Table Custom inclusions/exclusions */
  .matrix-box {
    border: 1px solid var(--color-line-muted);
    padding: var(--space-lg);
    background-color: var(--color-bg-card);
  }

  .matrix-list {
    list-style: none;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .matrix-list li {
    position: relative;
    padding-left: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .inclusion-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-green);
    font-weight: bold;
  }

  .exclusion-list li::before {
    content: '×';
    position: absolute;
    left: 0;
    color: var(--color-burgundy);
    font-weight: bold;
    font-size: 1.1rem;
  }

  /* Wizard navigation bar */
  .wizard-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .w-step {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid transparent;
  }

  .w-step.active {
    border-color: var(--color-primary-green);
    color: var(--color-primary-green);
    background-color: var(--color-bg-card);
  }

  .w-step-divider {
    color: var(--color-line-muted);
  }

  .wizard-panel {
    display: none;
    padding: var(--space-lg) 0;
  }

  .wizard-panel.active {
    display: block;
  }

  /* File upload stylized box */
  .file-upload-box {
    border: 1px dashed var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: var(--transition-fast);
  }

  .file-upload-box:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-paper);
  }

  .file-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 6px;
  }

  .file-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  /* AI Output briefing styled ledger folder */
  .ai-brief-dossier {
    border: 1px solid var(--color-line-muted);
    background-color: #1b1d1c;
    color: #FAF7F2;
    padding: var(--space-xl);
    font-family: monospace;
    font-size: 0.8rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    min-height: 250px;
    white-space: pre-line;
  }

  .typing-placeholder {
    color: var(--color-gold);
    text-align: center;
    padding-top: 50px;
    animation: flash 1s infinite alternate;
  }

  @keyframes flash {
    0% { opacity: 0.2; }
    100% { opacity: 1; }
  }

  /* Stripe box layout styling */
  .stripe-mock-box {
    max-width: 480px;
    margin: 0 auto;
    border: 1px solid #e6ebf1;
    border-radius: 4px;
    box-shadow: 0 15px 35px rgba(50,50,93,.1), 0 5px 15px rgba(0,0,0,.07);
    background-color: #f8f9fa;
  }

  .stripe-header {
    background-color: #635bff;
    color: white;
    padding: var(--space-md);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
  }

  .stripe-body {
    padding: var(--space-xl);
    background-color: white;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .stripe-price-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #32325d;
    margin-top: 6px;
  }

  .stripe-item-name {
    font-weight: 500;
    max-width: 70%;
  }

  .stripe-price {
    font-weight: bold;
  }

  .stripe-card-inputs {
    border: 1px solid #e6ebf1;
    padding: var(--space-md);
    background-color: #fcfcfc;
  }

  /* Google Calendar scheduling grid setup */
  .calendar-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
  }

  @media (min-width: 768px) {
    .calendar-layout-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .days-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .day-select-btn {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-sm);
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .day-select-btn.active, .day-select-btn:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-card);
    font-weight: 600;
  }

  .slots-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .slot-select-btn {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-sm);
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .slot-select-btn.active, .slot-select-btn:hover {
    background-color: var(--color-primary-green);
    color: var(--color-bg-paper);
    border-color: var(--color-primary-green);
    font-weight: 600;
  }

  /* Print Out receipt styling */
  .success-receipt-box {
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
  }

  .receipt-border-top {
    height: 6px;
    background-color: var(--color-primary-green);
  }

  .receipt-body {
    padding: var(--space-xl);
  }

  .receipt-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    border: 1px solid var(--color-line-muted);
    font-family: monospace;
    font-size: 0.85rem;
  }

  .receipt-row-data {
    border-bottom: 1px dashed var(--color-line-muted);
    padding-bottom: 6px;
  }

  .receipt-row-data:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .boundaries-banner {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-md);
    border-left: 3px solid var(--color-burgundy);
  }

  .boundaries-stamp {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }

  .boundaries-text {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
</style>

<script is:inline>
  // Complete client-side interactive wizard scripting (English)
  const wizard = document.getElementById('advisory-flow-wizard');
  
  if (wizard) {
    const panels = wizard.querySelectorAll('.wizard-panel');
    const steps = wizard.querySelectorAll('.w-step');
    const form = wizard.querySelector('#intake-form');
    
    // Panel handles
    const panelForm = wizard.querySelector('#wizard-panel-form');
    const panelSummary = wizard.querySelector('#wizard-panel-summary');
    const panelStripe = wizard.querySelector('#wizard-panel-stripe');
    const panelCalendar = wizard.querySelector('#wizard-panel-calendar');
    const panelSuccess = wizard.querySelector('#wizard-panel-success');
    
    // Flow values stored
    let userName = "";
    let selectedDay = "June 01, 2026";
    let selectedTime = "";

    const setStepActive = (stepName) => {
      steps.forEach(st => {
        if (st.getAttribute('data-nav') === stepName) {
          st.classList.add('active');
        } else {
          st.classList.remove('active');
        }
      });

      panels.forEach(pn => {
        pn.classList.remove('active');
      });
    };

    // Stage 1: Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Save user name
        const nameInput = document.getElementById('full_name');
        userName = nameInput ? nameInput.value : "Valued Investor";
        
        // Move to Stage 2 (AI summary loading)
        setStepActive('summary');
        panelSummary.classList.add('active');
        
        // Execute simulated Case Intake Agent Typewriter summary
        const aiBriefOutput = document.getElementById('ai-brief-output');
        const nextActions = document.getElementById('ai-next-actions');
        
        if (aiBriefOutput) {
          const mainTopic = document.getElementById('main_topic').value;
          const sector = document.getElementById('sector').value;
          const desc = document.getElementById('case_detail').value;
          
          let topicCategory = "INVESTMENT INCENTIVE FILING";
          let serviceFit = "Investment Incentives Advisory Directory";
          
          if (mainTopic === 'formation') {
            topicCategory = "ENTITY ESTABLISHMENT & REGISTER";
            serviceFit = "Market Entry & Company Setup Division";
          } else if (mainTopic === 'relocate') {
            topicCategory = "FOREIGN DIRECT CAPITAL RELOCATION";
            serviceFit = "Invest & Relocate Coordination Group";
          } else if (mainTopic === 'compliance') {
            topicCategory = "REGULATORY AND COMPLIANCE SCOPE AUDIT";
            serviceFit = "Regulatory Scoping & Compliance Liaison";
          }

          const summaryText = `[ CASE INTAKE ANALYTICAL DOSSIER BRIEF ]
          REF-ID: MG-REQ-${Date.now().toString().slice(-6)}-A
          --------------------------------------------------
          01. INVESTOR PROFILE: ${userName}
          02. HEDEF SEKTÖR: ${sector.toUpperCase()}
          03. DOSSIER CATEGORY: ${topicCategory}
          04. INTENT BRIEF: ${desc.slice(0, 120)}...
          05. FIT ADVISORY GROUP: ${serviceFit}
          --------------------------------------------------
          [ SUGGESTED MEETING AGENDA / GÖRÜŞME GÜNDEMİ ]
          1. Scoping minimum statutory threshold criteria (€150k - €1.5M TRY baseline) matching YTB.
          2. Analyzing geographic region advantages (Regions 1-6 map) and industrial tax reduction brackets.
          3. Charting immediate documentation checklists, bank setup clearances, and licensing barriers.
          --------------------------------------------------
          [ SECURITY RISK NOTES / RİSK NOTLARI ]
          - Sovereign administrative grants are exclusively under ministry authority; no approvals guaranteed.
          - Relocation processes involve strict ministerial reviews; partner coordination timeline detailed.
          - Dossier locked. Awaiting Stripe Harc session fee clearance.`;

          let i = 0;
          aiBriefOutput.innerHTML = "";
          
          const typeWriter = () => {
            if (i < summaryText.length) {
              aiBriefOutput.innerHTML += summaryText.charAt(i);
              i++;
              setTimeout(typeWriter, 5); // Fast typewriter speed
            } else {
              if (nextActions) nextActions.style.display = "block";
            }
          };
          
          setTimeout(typeWriter, 800);
        }
      });
    }

    // Stage 2: Proceed to Stripe Mock
    const toStripeBtn = document.getElementById('ai-to-stripe-btn');
    if (toStripeBtn) {
      toStripeBtn.addEventListener('click', () => {
        setStepActive('stripe');
        panelStripe.classList.add('active');
      });
    }

    // Stage 3: Stripe Pay Button
    const payBtn = document.getElementById('stripe-pay-btn');
    if (payBtn) {
      payBtn.addEventListener('click', () => {
        payBtn.innerHTML = "CLEARING HARC SESSION FEE...";
        payBtn.disabled = true;
        
        setTimeout(() => {
          setStepActive('calendar');
          panelCalendar.classList.add('active');
        }, 1500);
      });
    }

    // Stage 4: Google Calendar interactions
    const dayBtns = wizard.querySelectorAll('.day-select-btn');
    const slotBtns = wizard.querySelectorAll('.slot-select-btn');
    const confirmBtn = document.getElementById('confirm-booking-btn');

    dayBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        dayBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedDay = btn.getAttribute('data-day') || "June 01, 2026";
      });
    });

    slotBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        slotBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedTime = btn.getAttribute('data-time') || "";
        if (confirmBtn) confirmBtn.style.display = "inline-block";
      });
    });

    // Stage 5: Final Confirmation receipt printout
    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        setStepActive('success');
        panelCalendar.classList.remove('active');
        panelSuccess.classList.add('active');
        
        // Update Receipt fields dynamically
        const rName = document.getElementById('r-name');
        const rRef = document.getElementById('r-ref');
        const rDatetime = document.getElementById('r-datetime');
        
        if (rName) rName.textContent = userName;
        if (rRef) rRef.textContent = `MG-REQ-${Date.now().toString().slice(-6)}-A`;
        if (rDatetime) rDatetime.textContent = `${selectedDay} | ${selectedTime} (Turkey Time)`;
      });
    }
  }
</script>
