---
/* REF: MG-2026-ASTRO-EN-SERVICES-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Our Service Directories";
const pageDesc = "Strategic directories for State Investment Incentives, foreign corporate setup, relocations, and regulatory clearance in Türkiye.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-EN-SERVICES</span>
          <span class="classification-stamp">[ SERVICE DIRECTORY / ARCHIVE ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">02. ACTIVE DIRECTORIES</span>
          <h1 class="hero-main-title">Professional Advisory Scope & Portfolios</h1>
          <p class="hero-subtitle">Mentor Group provides board-level oversight across two core operational tracks, de-risking your investment entry in the Turkish jurisdiction.</p>
          <hr class="double-rule" />
        </div>

        <!-- Two Main Service Lines detailed -->
        <div class="services-list-wrapper">
          
          <!-- Service Area 1 -->
          <div class="service-area-block mb-xl" style="border: 1px solid var(--color-line-muted); padding: var(--space-xl); background-color: var(--color-bg-paper);">
            <div class="flex justify-between align-center mb-md" style="flex-wrap: wrap; gap: 10px;">
              <span class="sec-number">DIRECTORY A</span>
              <span class="ref-stamp">DEPT: INCENTIVES-EN</span>
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-primary-green); margin-bottom: var(--space-sm);">Investment Incentives in Türkiye</h2>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Formal administrative representation and dossier structuring to secure VAT exclusions, Customs Duty exemptions, corporate tax reductions, and social security premium subsidies from the Ministry of Industry and Technology.
            </p>
            
            <div class="double-rule" style="margin: 15px 0;"></div>
            
            <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
              <div class="ledger-col ledger-col-split" style="padding: 0 var(--space-md) 0 0;">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Incentive Certificate (YTB) Filing</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">End-to-end dossier formulation, aligning capital projections and technical scoping with state incentive regions (1-6 scale) for optimal grant matching.</p>
              </div>
              <div class="ledger-col" style="padding: 0 0 0 var(--space-md);">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Strategic & Project-Based Grants</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">Oversight for high-capital investments (exceeding 50M TRY), advanced R&D projects, and capital-intensive technology setups.</p>
              </div>
            </div>
            
            <div class="text-right" style="margin-top: var(--space-md);">
              <a href="/en/services/investment-incentives/" class="btn btn-primary">VIEW INCENTIVES DIRECTORY</a>
            </div>
          </div>

          <!-- Service Area 2 -->
          <div class="service-area-block" style="border: 1px solid var(--color-line-muted); padding: var(--space-xl); background-color: var(--color-bg-paper);">
            <div class="flex justify-between align-center mb-md" style="flex-wrap: wrap; gap: 10px;">
              <span class="sec-number">DIRECTORY B</span>
              <span class="ref-stamp">DEPT: RELOCATE-EN</span>
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-burgundy); margin-bottom: var(--space-sm);">Invest & Relocate to Türkiye</h2>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              A comprehensive entry pathway for global businesses, investment funds, and high-net-worth executives establishing a formal presence, securing operations, and de-risking bureaucracy in Türkiye.
            </p>
            
            <div class="double-rule" style="margin: 15px 0;"></div>
            
            <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
              <div class="ledger-col ledger-col-split" style="padding: 0 var(--space-md) 0 0;">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Entity Formation & Onboarding</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">Statutory registration of 100% foreign-owned LLC or Joint Stock corporations, bank account setup, tax ID constitution, and Trade Registry clearance.</p>
              </div>
              <div class="ledger-col" style="padding: 0 0 0 var(--space-md);">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Administrative Relocation Coordination</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">Oversight of operational licenses, executive work permits, and cross-border commercial compliance in coordination with accredited partner networks.</p>
              </div>
            </div>
            
            <div class="text-right" style="margin-top: var(--space-md);">
              <a href="/en/services/invest-relocate/" class="btn btn-burgundy">EXPLORE RELOCATION DOSSIER</a>
            </div>
          </div>

        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center" style="margin-top: 25px;">
          <a href="/en/advisory/" class="btn btn-secondary">BOOK INITIAL ADVISORY SESSION</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
