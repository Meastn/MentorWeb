---
/* REF: MG-2026-ASTRO-EN-RELOCATE-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Investment & Market Entry Advisory in Türkiye";
const pageDesc = "International corporate formation, 100% foreign capital registrations, market entry advisory, and administrative relocation oversight in Türkiye.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-EN-SERVICERELOCATE</span>
          <span class="classification-stamp">[ SOVEREIGN MARKET ENTRY / GLOBAL INVESTORS ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">02/A. GLOBAL INVESTORS DIRECTORY</span>
          <h1 class="hero-main-title">Investment & Market Entry Advisory in Türkiye</h1>
          <p class="hero-subtitle">Bespoke administrative oversight, company formation scoping, and regulatory coordination for global businesses, investment funds, and executives establishing presence in Türkiye.</p>
          <hr class="double-rule" />
        </div>

        <!-- 6 Main Sections Grid -->
        <div class="ledger-row ledger-row-2col">
          
          <!-- Column 1: Market Entry & Entity Setup -->
          <div class="ledger-col ledger-col-split" style="background-color: var(--color-bg-card);">
            <span class="sec-number">SECTION 01</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Market Entry & Corporate Setup</h3>
            
            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-top: 15px; margin-bottom: var(--space-xs);">1. Turkey Entry & Market Scoping</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Regulatory risk screening, identification of bureaucratic barriers, and coordination of a strategic compliance roadmap for foreign corporations planning to enter the Turkish market.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">2. Company Formation & Commercial Infrastructure</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Administrative coordination of 100% foreign-owned Limited Liability Companies (LLC - minimum 50,000 TRY) or Joint Stock Companies (JSC - minimum 250,000 TRY), including bank capital blockages, temporary tax IDs, and Chamber of Commerce registrations.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">3. Industrial Site Selection & Licensing</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
              Oversight of site allocations within Organized Industrial Zones (OIZ), free zones, or industrial regions, including municipal commercial permits, operational licenses, and environmental impact assessment (EIA) protocols.
            </p>
          </div>

          <!-- Column 2: Incentive Scoping & Partner Relocation -->
          <div class="ledger-col">
            <span class="sec-number">SECTION 02</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Incentives, Permits & Compliance</h3>
            
            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-top: 15px; margin-bottom: var(--space-xs);">4. Incentives Eligibility Scoping</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Preliminary audit of investment plans against Sanayi Bakanlığı incentive regulations (YTB), regional benefit modeling, and capital threshold requirements (2026 mandates).
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">5. Residency, Work Permits & Executive Relocation</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Coordinating work permit registrations with the Ministry of Labor, residency filings, and relocations for foreign board members, directors, and technical personnel through our registered partner network.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">6. Tax, Fiscal & Regulatory Compliance</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
              Liaison coordination for Double Taxation Treaties (DTAA) compliance, KVKK/GDPR data regulations, and local corporate accounting alignment with registered tax advisory partners.
            </p>
          </div>

        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <!-- Informational Boundaries Disclaimer -->
        <div class="boundaries-banner">
          <span class="boundaries-stamp">[ REGULATORY BOUNDARY & DISCLAIMER ]</span>
          <p class="boundaries-text">
            <strong>B2B Advisory & Process Coordination:</strong> Mentor Group is strictly a strategic advisory firm and does not operate as a law office or certified public accounting firm. All sovereign litigations, formal court representations, corporate tax audit sign-offs, and citizenship-by-investment legal submissions are executed exclusively through bar-registered attorneys and licensed accountants within our <strong>registered legal and tax advisory partners</strong>, ensuring complete statutory compliance. We coordinate with relevant public authorities, investment office resources, local administrations, OIZ/free zone management, and registered expert service providers to facilitate your investment processes.
          </p>
        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center" style="margin-top: 25px;">
          <h4 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: var(--space-xs);">Secure Your Market Entry Timeline</h4>
          <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">Map out company registration timelines, tax structures, and relocation steps during a 30-minute Initial Advisory Session.</p>
          <a href="/en/advisory/" class="btn btn-primary">BOOK INITIAL ADVISORY SESSION</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
