---
/* REF: MG-2026-ASTRO-EN-RELOCATE-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Invest & Relocate to Türkiye Portfolio";
const pageDesc = "International corporate formation, 100% foreign capital tescil registrations, market entry advisory, and administrative relocation oversight in Türkiye.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-EN-SERVICERELOCATE</span>
          <span class="classification-stamp">[ SOVEREIGN MARKET ENTRY / GLOBAL INVESTORS ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">02/B. RELOCATION DIRECTORY</span>
          <h1 class="hero-main-title">Invest & Relocate to Türkiye Advisory Directory</h1>
          <p class="hero-subtitle">Bespoke administrative oversight, company formation scoping, and regulatory coordination for global businesses, investment funds, and executives establishing presence in Türkiye.</p>
          <hr class="double-rule" />
        </div>

        <!-- Detailed Scoping Matrix -->
        <div class="ledger-row ledger-row-2col">
          <div class="ledger-col ledger-col-split" style="background-color: var(--color-bg-card);">
            <span class="sec-number">01. STATUTORY ESTABLISHMENT</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Entity Setup & Corporate Onboarding</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Corporate formations featuring 100% foreign-ownership protection are governed under the Turkish Commercial Code (TCC) and structured as follows:
            </p>
            <ul style="font-size: 0.82rem; color: var(--color-text-ink); margin-left: 20px; margin-bottom: 20px; line-height: 1.6;">
              <li><strong>Statutory Capital Thresholds:</strong> Minimum 50,000 TRY for Joint Stock Companies (JSC), 10,000 TRY for Limited Liability Companies (LLC). Higher levels are recommended for bank clearance and license scopes.</li>
              <li><strong>Banka & Tax Pre-Onboarding:</strong> Securing temporary tax identification credentials and coordinating capital blockage account setup.</li>
              <li><strong>Trade Registry (MERSİS) Tescil:</strong> Drafting corporate bylaws, executing notarized translations, and securing registration approval from the domestic Chamber of Commerce.</li>
            </ul>
          </div>

          <div class="ledger-col">
            <span class="sec-number">02. COMPLIANCE & LIAISON</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Administrative Clearance & Partner Alignment</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Operating an international entity demands close coordination with qualified, certified domestic professionals:
            </p>
            <table class="matrix-table" style="font-size: 0.8rem; margin-bottom: 10px;">
              <thead>
                <tr>
                  <th>OPERATIONAL STREAM</th>
                  <th>OUR LIAISON COORDINATION MODEL</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Executive Work Permits</strong></td>
                  <td>Scoping and organizing ministry submissions to secure work credentials for foreign directors and key technical staff.</td>
                </tr>
                <tr>
                  <td><strong>Tax & Accounting Audit</strong></td>
                  <td>Liaison alignment with accredited certified public accountants (SMMM) and tax attorneys for DTAA (Double Tax Treaties) screening.</td>
                </tr>
                <tr>
                  <td><strong>Commercial Land & Licensing</strong></td>
                  <td>Coordination of industrial site allocations, municipal permits, environmental clearances, and operational licenses.</td>
                </tr>
                <tr>
                  <td><strong>Incentive Readiness</strong></td>
                  <td>Ensuring the newly constituted entity satisfies requirements to apply for state investment incentives (VAT / corporate tax cuts).</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <!-- Informational Boundaries Disclaimer -->
        <div class="boundaries-banner">
          <span class="boundaries-stamp">[ REGULATORY BOUNDARY & DISCLAIMER ]</span>
          <p class="boundaries-text">
            Mentor Group is strictly a strategic advisory firm and does not operate as a law office or certified public accounting firm. All sovereign litigations, formal court representations, corporate tax audit sign-offs, and citizenship-by-investment legal submissions are executed exclusively through bar-registered attorneys and licensed accountants within our accredited partner network, ensuring complete statutory compliance.
          </p>
        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center" style="margin-top: 25px;">
          <h4 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: var(--space-xs);">Secure Your Market Entry Timeline</h4>
          <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">Map out company tescil timelines, tax structures, and relocation steps during a 30-minute Initial Advisory Session.</p>
          <a href="/en/advisory/" class="btn btn-primary">BOOK INITIAL ADVISORY SESSION</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
