---
/* REF: MG-2026-ASTRO-EN-HOME-01 */
import Layout from '../../layouts/Layout.astro';
import RouteFinder from '../../components/RouteFinder.astro';
import AdvisoryAssistant from '../../components/AdvisoryAssistant.astro';
import ClientLogos from '../../components/ClientLogos.astro';

const pageTitle = "Home";
const pageDesc = "Structured advisory for investment incentives, company formation, relocation-related coordination, and regulatory processes in Türkiye.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <!-- 01. BIFURCATED HERO DOSSIER -->
  <section class="hero-section py-xl">
    <div class="ledger-container">
      <div class="hero-dossier-wrapper">
        <div class="dossier-header-bar">
          <span class="ref-stamp">DOSSIER-REF: MG-2026-EN-HOME</span>
          <span class="classification-stamp">[ ADVISORY DOSSIER ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">01. CORPORATE ADVISORY</span>
          <h1 class="hero-main-title">Investment, Incentives, Company Formation, and Process Coordination</h1>
          <p class="hero-subtitle">Structured advisory for international investors and businesses planning investments in Türkiye.</p>
          
          <div class="hero-cta-row" style="display: flex; gap: var(--space-md); margin-top: var(--space-md); margin-bottom: var(--space-md); flex-wrap: wrap;">
            <a href="/en/advisory/" class="btn btn-burgundy">01. Book Initial Review</a>
            <a href="/en/services/" class="btn btn-secondary" style="border-color: var(--color-text-ink); color: var(--color-text-ink);">02. Explore Service Portfolio</a>
          </div>

          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-top: 15px; margin-bottom: 5px; font-style: italic; border-left: 2px solid var(--color-burgundy); padding-left: 10px;">
            "Mentor Group addresses investment, incentives, company formation, and corporate growth decisions through the integrated lenses of financial resilience, operational efficiency, and strategic alignment."
          </p>
          
          <hr class="double-rule" />
        </div>

        <!-- The Bifurcated Paths Grid -->
        <div class="ledger-row ledger-row-2col">
          <!-- Path 1: International Investors -->
          <div class="ledger-col ledger-col-split path-column burgundy-path">
            <span class="sec-number">INTERNATIONAL INVESTORS</span>
            <h3 class="path-title">Invest & Relocate to Türkiye Portfolio</h3>
            <p class="path-desc">A structured operational directory for foreign direct investors establishing domestic entities, securing work credentials, and managing commercial land or licenses.</p>
            <ul class="path-bullet-list">
              <li>100% foreign-owned corporate formations (LLC/JSC)</li>
              <li>Relocation clearance, licensing, and partner coordination</li>
              <li>Cross-border tax compliance and accounting clearance</li>
            </ul>
            <div style="margin-top: auto; padding-top: var(--space-md);">
              <a href="/en/services/invest-relocate/" class="btn btn-burgundy w-full">INVESTOR ROADMAP</a>
            </div>
          </div>

          <!-- Path 2: Turkish Corporates -->
          <div class="ledger-col path-column green-path">
            <span class="sec-number">TÜRKİYE-BASED COMPANIES</span>
            <h3 class="path-title">Investment Incentive Certification in Türkiye</h3>
            <p class="path-desc">Structured advisory for local and multinational corporations seeking corporate tax cuts, VAT exemptions, customs duty waivers, and social security premium subsidies.</p>
            <ul class="path-bullet-list">
              <li>Sanayi ve Teknoloji Bakanlığı incentive scoping</li>
              <li>Fiscal feasibility and capital structure alignment</li>
              <li>Dossier preparation and compliance oversight</li>
            </ul>
            <div style="margin-top: auto; padding-top: var(--space-md);">
              <a href="/en/services/investment-incentives/" class="btn btn-primary w-full">INCENTIVE DOSSIER SPEC</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02. INTERACTIVE ROUTE FINDER SECTION -->
  <section class="section-divider-top py-xl" style="background-color: var(--color-bg-card);">
    <div class="ledger-container">
      <div class="section-header-box mb-lg">
        <span class="sec-number">02. REGULATORY SCALING</span>
        <h2>Strategic Route Finder Dossier</h2>
        <p class="section-subtitle">Answer five structural regulatory questions to determine your appropriate path and preliminary advisory support.</p>
        <hr class="double-rule" style="margin-top: 10px;" />
      </div>
      
      <RouteFinder locale="en" />
    </div>
  </section>

  <!-- 03. SERVICE PORTFOLIO OVERVIEW -->
  <section class="py-xl">
    <div class="ledger-container">
      <div class="section-header-box mb-lg">
        <span class="sec-number">03. ACTIVE SERVICES</span>
        <h2>Service Portfolio & Quality Standards</h2>
        <p class="section-subtitle">We manage bureaucratic lifecycles and incentive regulations with the highest degree of compliance authority.</p>
        <hr class="double-rule" style="margin-top: 10px;" />
      </div>

      <div class="ledger-row ledger-row-2col">
        <!-- Service Card 1 -->
        <div class="ledger-col ledger-col-split service-card">
          <span class="ref-stamp">SERVICE-ID: EN-INV</span>
          <h3 class="service-card-title">Global Investors & Entity Setup</h3>
          <p class="service-card-text">Comprehensive market entry oversight, incorporating 100% foreign-owned corporate setup, bank onboarding, commercial land clearance, and residency coordination with registered partner networks.</p>
          <a href="/en/services/invest-relocate/" class="btn-link">Explore Relocation Roadmap &rarr;</a>
        </div>

        <!-- Service Card 2 -->
        <div class="ledger-col service-card">
          <span class="ref-stamp">SERVICE-ID: EN-YTB</span>
          <h3 class="service-card-title">Investment Incentive Certification</h3>
          <p class="service-card-text">Oversight for regional, priority, and strategic state investment certificate submissions, managing VAT exclusions, customs exemptions, tax deductions, and SGK benefits with the Ministry.</p>
          <a href="/en/services/investment-incentives/" class="btn-link">Review Incentive Specs &rarr;</a>
        </div>
      </div>

      <div style="margin-top: 25px; border-left: 2px solid var(--color-burgundy); padding-left: 15px; font-style: italic; font-size: 0.82rem; color: var(--color-text-muted);">
        * Statutory incentive thresholds and investment classifications are regularly updated in the Knowledge Center.
      </div>
    </div>
  </section>

  <ClientLogos locale="en" />

  <!-- 04. METHODOLOGY & TIMELINE -->
  <section class="py-xl" style="background-color: var(--color-bg-card);">
    <div class="ledger-container">
      <div class="section-header-box mb-lg">
        <span class="sec-number">04. METHODOLOGY</span>
        <h2>Our Working Principles & Engagement Standards</h2>
        <p class="section-subtitle">Regulatory clearance is a strict science. We manage each file through four formal operational steps.</p>
        <hr class="double-rule" style="margin-top: 10px;" />
      </div>

      <div class="timeline-ledger">
        <div class="timeline-step">
          <div class="timeline-num">01</div>
          <div class="timeline-content">
            <h4>Case Intake & Preliminary Screening</h4>
            <p>We initiate all engagements with the paid Initial Advisory Session, clarifying parameters, scoping relevant support networks, and compiling the baseline dossier draft.</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="timeline-num">02</div>
          <div class="timeline-content">
            <h4>Dossier Compilation & Structural Audit</h4>
            <p>Our specialists compile all statutory filings, tech briefs, and financial projections in exact alignment with Ministry schemas, ensuring zero administrative delays.</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="timeline-num">03</div>
          <div class="timeline-content">
            <h4>Official Submission & Executive Liaison</h4>
            <p>We execute the formal filings and manage subsequent administrative coordination with ministries, trade boards, and licensing authorities.</p>
          </div>
        </div>

        <div class="timeline-step">
          <div class="timeline-num">04</div>
          <div class="timeline-content">
            <h4>Post-Grant Verification & Regulatory Audit</h4>
            <p>Following approval, we provide continuous audit tracking, facilitating incentive close-out visas, employment quotas, and statutory compliance audits.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05. ADVISORY ASSISTANT PANEL -->
  <section class="py-xl">
    <div class="ledger-container">
      <div class="section-header-box mb-lg text-center">
        <span class="sec-number">05. COMPLIANCE SCREENING</span>
        <h2>Regulatory Knowledge Panel</h2>
        <p class="section-subtitle" style="max-width: 700px; margin: 0 auto;">Access verified preliminary insights, service dossiers, and regulatory briefing parameters.</p>
        <hr class="double-rule" style="margin-top: 10px;" />
      </div>
      
      <AdvisoryAssistant locale="en" />
    </div>
  </section>

  <!-- 06. INITIAL ADVISORY CTA BLOCK -->
  <section class="py-xl text-center" style="background-color: var(--color-primary-green); color: var(--color-bg-paper);">
    <div class="ledger-container">
      <div class="advisory-cta-panel">
        <span class="ref-stamp" style="color: rgba(250,247,242,0.6);">REF: MG-BOOK-EN-2026</span>
        <h2 style="color: var(--color-bg-paper); font-size: 2.2rem; margin-top: 10px;">Structure Your Investment Portfolio</h2>
        <p style="max-width: 750px; margin: var(--space-md) auto var(--space-lg); font-size: var(--size-body-large); opacity: 0.9;">
          Establish the legal, tax, and incentive boundaries of your Turkish investment during a structured 30-minute "Initial Advisory Session". Detailed case intake is mandatory before scheduling.
        </p>
        <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
          <a href="/en/advisory/" class="btn btn-burgundy" style="font-size: 0.95rem; font-weight: 600; padding: 12px 24px;">01. BOOK INITIAL ADVISORY SESSION</a>
          <a href="/en/services/" class="btn btn-secondary" style="border-color: var(--color-bg-paper); color: var(--color-bg-paper); font-size: 0.95rem; padding: 12px 24px;">02. VIEW SERVICES DIRECTORY</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 07. INSIGHTS PREVIEW -->
  <section class="py-xl">
    <div class="ledger-container">
      <div class="section-header-box mb-lg">
        <span class="sec-number">06. INTELLECTUAL LEDGER</span>
        <h2>Executive Briefings & Market Entry Briefs</h2>
        <p class="section-subtitle">Intellectual capital, statutory briefs, and analysis prepared for our corporate partners.</p>
        <hr class="double-rule" style="margin-top: 10px;" />
      </div>

      <div class="ledger-row ledger-row-2col">
        <!-- Insight 1 -->
        <div class="ledger-col ledger-col-split insight-preview-card">
          <span class="ref-stamp">REGULATORY EXPLAINER</span>
          <h4 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-top: 5px; margin-bottom: 10px;">
            What Foreign Investors Should Know Before Investing in Türkiye
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: var(--space-md);">
            An executive audit of statutory guarantees, corporate dispute channels, currency rules, and capital repatriation rules for international direct investments.
          </p>
          <a href="/en/insights/what-foreign-investors-should-know/" class="btn-link" style="font-size: 0.8rem;">Read Executive Brief &rarr;</a>
        </div>

        <!-- Insight 2 -->
        <div class="ledger-col insight-preview-card">
          <span class="ref-stamp">MARKET ENTRY NOTE</span>
          <h4 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-top: 5px; margin-bottom: 10px;">
            Company Formation in Türkiye: First Considerations
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: var(--space-md);">
            A comparative ledger of LLC and Joint Stock entity features, tax residency parameters, corporate structure controls, and statutory timeline expectations.
          </p>
          <a href="/en/insights/company-formation-in-turkiye/" class="btn-link" style="font-size: 0.8rem;">Read Executive Brief &rarr;</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-dossier-wrapper {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-xl);
  }

  .dossier-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-line-muted);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .classification-stamp {
    font-family: monospace;
    font-size: var(--size-meta);
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .hero-title-box {
    margin-bottom: var(--space-xl);
  }

  .hero-main-title {
    font-size: 2.8rem;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--size-body-large);
    color: var(--color-text-muted);
    max-width: 800px;
    line-height: 1.6;
  }

  .path-column {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
  }

  .path-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .path-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .path-bullet-list {
    list-style: none;
    font-size: 0.85rem;
    margin-bottom: var(--space-lg);
  }

  .path-bullet-list li {
    position: relative;
    padding-left: var(--space-md);
    margin-bottom: 6px;
    color: var(--color-text-ink);
  }

  .path-bullet-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-line-muted);
  }

  .green-path .path-title {
    color: var(--color-primary-green);
  }

  .burgundy-path .path-title {
    color: var(--color-burgundy);
  }

  .section-header-box h2 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .section-subtitle {
    font-size: var(--size-body-large);
    color: var(--color-text-muted);
    max-width: 800px;
  }

  .service-card {
    padding: var(--space-xl);
  }

  .service-card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .service-card-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  /* Timeline Styles */
  .timeline-ledger {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
  }

  .timeline-step {
    display: flex;
    border-bottom: 1px solid var(--color-line-muted);
  }

  .timeline-step:last-child {
    border-bottom: none;
  }

  .timeline-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-gold);
    width: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-right: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
  }

  .timeline-content {
    padding: var(--space-lg);
    flex: 1;
  }

  .timeline-content h4 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .timeline-content p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
    line-height: 1.5;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 767px) {
    .timeline-step {
      flex-direction: column;
    }
    
    .timeline-num {
      width: 100%;
      height: 50px;
      border-right: none;
      border-bottom: 1px solid var(--color-line-muted);
    }
  }
</style>
