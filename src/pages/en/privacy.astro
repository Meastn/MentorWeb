---
/* REF: MG-2026-ASTRO-EN-PRIVACY-01 */
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Privacy & GDPR Statement";
const pageDesc = "Mentor Group Advisory GDPR compliance, data processing guidelines, and privacy safeguards for international clients.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-EN-PRIVACY</span>
          <span class="classification-stamp">[ REGULATORY HARMONY / GDPR ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">08. REGULATORY CLEARANCE</span>
          <h1 class="hero-main-title">Privacy Policy & GDPR Compliance Statement</h1>
          <p class="hero-subtitle">Mentor Group maintains strict data processing safeguards, ensuring that all submitted corporate dossiers and contact metrics adhere to international GDPR principles.</p>
          <hr class="double-rule" />
        </div>

        <div class="privacy-content" style="font-size: 0.85rem; color: var(--color-text-ink); line-height: 1.7; display: flex; flex-direction: column; gap: 20px;">
          
          <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 6px; color: var(--color-primary-green);">01. Data Controller</h3>
            <p style="color: var(--color-text-muted);">
              Under the General Data Protection Regulation (GDPR) and regional commercial codes, your data controller is "Mentor Group Danışmanlık A.Ş." (hereinafter referred to as "the Firm"). We oversee the secure management of B2B client dossiers and contact registries.
            </p>
          </div>

          <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 6px; color: var(--color-primary-green);">02. Core Scopes of Processing</h3>
            <p style="color: var(--color-text-muted);">
              We process personal and corporate data (Name, email, phone coordinates, corporate affiliation, investment ranges, and sector objectives) exclusively to compile preliminary analytical dossiers for the paid "Initial Advisory Session" and to address official B2B inquiries.
            </p>
          </div>

          <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 6px; color: var(--color-primary-green);">03. Transfers and Disclosures</h3>
            <p style="color: var(--color-text-muted);">
              We never monetize, share, or lease commercial lists to third-party brokers. Data is transferred strictly to official government registries (such as the Ministry of Industry and Technology) and our accredited legal, accounting, and fiscal partner networks only when explicit scoping authorizations are signed.
            </p>
          </div>

          <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 6px; color: var(--color-primary-green);">04. Your Rights</h3>
            <p style="color: var(--color-text-muted);">
              Under GDPR, you maintain the right to review, update, or request the complete erasure of your active data records. All such formal inquiries should be addressed directly to our compliance officer at <strong>advisory@mentorgroup.com.tr</strong>.
            </p>
          </div>

        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center">
          <a href="/en/" class="btn btn-secondary">RETURN TO MAIN DOSSIER</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
