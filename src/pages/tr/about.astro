---
/* REF: MG-2026-ASTRO-TR-ABOUT-01 */
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Hakkımızda / Kurumsal";
const pageDesc = "Mentor Group’un kurumsal yapısı, stratejik kurul danışmanlığı yetkinlikleri ve Türkiye’deki idari koordinasyon gücü.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-TR-ABOUT</span>
          <span class="classification-stamp">[ KURUMSAL DOSYA / ARCHIVE ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">03. BİZ KİMİZ</span>
          <h1 class="hero-main-title">Kurumsal Kimlik ve Yönetim Kurulu Seviyesinde Yetkinlik</h1>
          <p class="hero-subtitle">Mentor Group, Türkiye Cumhuriyeti sınırları içerisinde ve uluslararası pazarlarda, büyük ölçekli sanayi yatırımlarının bürokratik sevk koordinasyonunu ve teşvik planlamasını yürütür.</p>
          <hr class="double-rule" />
        </div>

        <!-- Corporate Grid Section -->
        <div class="ledger-row ledger-row-2col">
          <div class="ledger-col ledger-col-split">
            <span class="sec-number">01. STRATEJİK HEDEF</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Sorumluluk ve Mevzuat Hakimiyeti</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Türkiye’de sanayi, enerji, bilişim, Ar-Ge ve imalat yatırımlarının resmî makamlar nezdindeki tescil, teşvik ve yasal uyum süreçleri, hata kabul etmeyen strict idari operasyonlardır.
            </p>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6;">
              Mentor Group, kurulduğu ilk günden bu yana devlet destekleri ve teşvik prosedürlerinde, T.C. Sanayi ve Teknoloji Bakanlığı ile diğer ilgili kurumların mevzuat standartlarına %100 uyum esasıyla çalışır. Amacımız, yatırımcıların bürokratik engellere takılmaksızın en doğru destek modelinden azami oranda faydalanmasını sağlamaktır.
            </p>
          </div>

          <div class="ledger-col">
            <span class="sec-number">02. ULUSLARARASI KÖPRÜ</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Yabancı Sermaye Koordinasyon Gücü</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Uluslararası sermaye gruplarının Türkiye’ye taşınması, şirket kurulumu, vergilendirme altyapısı ve idari yerleşim süreçleri yüksek derecede gizlilik ve ihtimam gerektirir.
            </p>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6;">
              Temsil ve idari takip yetkimiz doğrultusunda, yabancı fonlar ve yatırımcılar için Türkiye’deki ilk adım planlamalarını organize ediyoruz. Akredite yasal, vergisel ve hukuki ortaklarımızın da eşgüdümünde, Türkiye pazar giriş süreçlerinin her aşamasını board-level güvence altında tamamlıyoruz.
            </p>
          </div>
        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <!-- Ankara & Istanbul offices details -->
        <div class="offices-box" style="margin-top: var(--space-lg);">
          <span class="sec-number">03. OFİSLERİMİZ VE İRTİBAT KOORDİNATLARI</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-md);">Resmi İdari Merkezlerimiz</h3>
          
          <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
            <div class="ledger-col ledger-col-split" style="border: 1px solid var(--color-line-muted); background-color: var(--color-bg-card); padding: var(--space-lg); margin-bottom: var(--space-md);">
              <h4 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: var(--space-xs);">İstanbul İdari Temsilciliği</h4>
              <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
                Büyükdere Caddesi üzerinde yer alan İstanbul temsilciliğimiz, finansal kuruluşlar, fonlar ve uluslararası şirketlerin pazar giriş ve idari koordinasyon süreçlerini yönetir.<br /><br />
                <strong>Adres:</strong> Levent Loft, Büyükdere Cd. No:201, 34394 Beşiktaş/İstanbul<br />
                <strong>E-Posta:</strong> istanbul@mentorgroup.com.tr
              </p>
            </div>
            
            <div class="ledger-col" style="border: 1px solid var(--color-line-muted); background-color: var(--color-bg-card); padding: var(--space-lg); margin-bottom: var(--space-md);">
              <h4 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: var(--space-xs);">Ankara Mevzuat ve Bürokrasi Koordinasyon Ofisi</h4>
              <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
                Bakanlıklar nezdindeki başvuru, dosyalama, teşvik belgesi tescil ve revizyon işlemlerimiz, Ankara ofisimizin uzman kadrosu tarafından doğrudan takip edilmektedir.<br /><br />
                <strong>Adres:</strong> Mahall Ankara, Dumlupınar Blv. No:274, 06530 Çankaya/Ankara<br />
                <strong>E-Posta:</strong> ankara@mentorgroup.com.tr
              </p>
            </div>
          </div>
        </div>

        <div class="text-center" style="margin-top: 25px;">
          <a href="/tr/advisory/" class="btn btn-primary">İLK DEĞERLENDİRME RANDEVUSU AL</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
