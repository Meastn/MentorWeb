---
/* REF: MG-2026-ASTRO-TR-SERVICES-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Hizmetlerimiz / Faaliyet Alanları";
const pageDesc = "Türkiye’de Yatırım Teşvik Belgesi, devlet destekleri ve yabancı yatırım yerleşim koordinasyonunda sunduğumuz resmi hizmetler dizini.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-TR-SERVICES</span>
          <span class="classification-stamp">[ FAALİYET DİZİNİ / SERVICES INDEX ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">02. FAALİYET ALANLARIMIZ</span>
          <h1 class="hero-main-title">Resmi Hizmet Kapsamı ve Danışmanlık Direktörlüğü</h1>
          <p class="hero-subtitle">Mentor Group, Türkiye’deki en kapsamlı iki uzmanlık alanında, devlet destekleri ve kurumsal yerleşim uyum koordinasyonunu yönetmektedir.</p>
          <hr class="double-rule" />
        </div>

        <!-- Two Main Service Lines detailed -->
        <div class="services-list-wrapper">
          
          <!-- Service Area 1 -->
          <div class="service-area-block mb-xl" style="border: 1px solid var(--color-line-muted); padding: var(--space-xl); background-color: var(--color-bg-paper);">
            <div class="flex justify-between align-center mb-md" style="flex-wrap: wrap; gap: 10px;">
              <span class="sec-number">DİREKTÖRLÜK A</span>
              <span class="ref-stamp">DEPT: INCENTIVES-TR</span>
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-primary-green); margin-bottom: var(--space-sm);">Türkiye’de Yatırım ve Teşvik Danışmanlığı</h2>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              T.C. Sanayi ve Teknoloji Bakanlığı nezdindeki Yatırım Teşvik Belgesi (YTB) başvurularının scoping, fizibilite, evrak hazırlanması, başvuru tescili ve kapatma vizelerine kadar tüm idari takibi.
            </p>
            
            <div class="double-rule" style="margin: 15px 0;"></div>
            
            <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
              <div class="ledger-col ledger-col-split" style="padding: 0 var(--space-md) 0 0;">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Yatırım Teşvik Belgesi (YTB)</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">KDV istisnası, gümrük vergisi muafiyeti, vergi indirimi ve SGK prim desteklerini kapsayan başvuru dosyalarının hazırlanması ve idari onay süreçlerinin takibi.</p>
              </div>
              <div class="ledger-col" style="padding: 0 0 0 var(--space-md);">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Proje Bazlı & Stratejik Teşvikler</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">Büyük ölçekli, stratejik veya 50 Milyon TL üzerindeki Ar-Ge/teknoloji yatırımları için devlet yardımları, finansal hibe destekleri ve bölge analizleri.</p>
              </div>
            </div>
            
            <div class="text-right" style="margin-top: var(--space-md);">
              <a href="/tr/services/investment-incentives/" class="btn btn-primary">DETAYLI TEŞVİK REHBERİNE GEÇ</a>
            </div>
          </div>

          <!-- Service Area 2 -->
          <div class="service-area-block" style="border: 1px solid var(--color-line-muted); padding: var(--space-xl); background-color: var(--color-bg-paper);">
            <div class="flex justify-between align-center mb-md" style="flex-wrap: wrap; gap: 10px;">
              <span class="sec-number">DİREKTÖRLÜK B</span>
              <span class="ref-stamp">DEPT: RELOCATE-EN</span>
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-burgundy); margin-bottom: var(--space-sm);">Invest & Relocate to Türkiye</h2>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md);">
              Türkiye pazarına girmek, doğrudan yatırım yapmak veya şirketini taşımak isteyen uluslararası yatırımcılar, fonlar ve yabancı uyruklu yöneticiler için resmi kuruluş ve yerleşim koordinasyonu.
            </p>
            
            <div class="double-rule" style="margin: 15px 0;"></div>
            
            <div class="ledger-row ledger-row-2col" style="border: none; margin-bottom: 0;">
              <div class="ledger-col ledger-col-split" style="padding: 0 var(--space-md) 0 0;">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">Şirket Kuruluşu & Pazar Girişi</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">%100 yabancı sermayeli limited (LTD) veya anonim (AŞ) şirket tescilleri, banka hesabı blokaj tescilleri, vergi kimlik numarası tescili ve ticaret odası işlemleri.</p>
              </div>
              <div class="ledger-col" style="padding: 0 0 0 var(--space-md);">
                <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">İdari ve Yasal Uyum Koordinasyonu</h4>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5;">Akredite yasal, mali ve hukuk ortaklarımız vasıtasıyla oturum/çalışma izinleri, vergilendirme planlaması, KVKK ve ticari tescil uyumluluklarının denetimi.</p>
              </div>
            </div>
            
            <div class="text-right" style="margin-top: var(--space-md);">
              <a href="/tr/services/invest-relocate/" class="btn btn-burgundy">DETAYLI YATIRIMCI REHBERİNE GEÇ</a>
            </div>
          </div>

        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center" style="margin-top: 25px;">
          <a href="/tr/advisory/" class="btn btn-secondary">İLK DEĞERLENDİRME RANDEVUSU AL</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
