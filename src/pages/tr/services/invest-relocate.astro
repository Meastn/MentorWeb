---
/* REF: MG-2026-ASTRO-TR-RELOCATE-01 */
import Layout from '../../../layouts/Layout.astro';

const pageTitle = "Uluslararası Yatırımcılar İçin Türkiye’ye Yatırım ve Yerleşim";
const pageDesc = "Uluslararası yatırımcılar için Türkiye’de şirket kuruluşu, pazar giriş stratejileri ve idari yerleşim koordinasyonu.";
---

<Layout title={pageTitle} description={pageDesc}>
  
  <section class="py-xl">
    <div class="ledger-container">
      
      <div class="dossier-box">
        <div class="dossier-header-bar">
          <span class="ref-stamp">REF: MG-2026-TR-SERVICERELOCATE</span>
          <span class="classification-stamp">[ DIŞ YATIRIM MEVZUATI / GLOBAL INVESTORS ]</span>
        </div>

        <div class="hero-title-box">
          <span class="sec-number">02/A. YABANCI YATIRIMCI DEPARTMANI</span>
          <h1 class="hero-main-title">Uluslararası Yatırımcılar İçin Türkiye’ye Yatırım ve Yerleşim</h1>
          <p class="hero-subtitle">Türkiye Cumhuriyeti’nde ticari varlık göstermek, doğrudan yabancı yatırım (DYY) gerçekleştirmek ve idari yerleşim süreçlerini yürütmek isteyen uluslararası kurum ve sermaye sahiplerine idari süreç koordinasyonu.</p>
          <hr class="double-rule" />
        </div>

        <!-- 6 Main Sections Grid -->
        <div class="ledger-row ledger-row-2col">
          
          <!-- Column 1: Market Entry & Entity Setup -->
          <div class="ledger-col ledger-col-split" style="background-color: var(--color-bg-card);">
            <span class="sec-number">BÖLÜM 01</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Pazar Girişi ve Şirket Kuruluşu</h3>
            
            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-top: 15px; margin-bottom: var(--space-xs);">1. Türkiye Pazarına Giriş</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Pazara girmeyi planlayan yabancı sermayeli kuruluşlar için yasal risk taramaları, idari bariyerlerin tespiti ve stratejik mevzuat uyumu yol haritasının hazırlanması koordinasyonu.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">2. Şirket Kuruluşu ve Ticari Altyapı</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              %100 yabancı sermaye korumalı limited (LTD - asgari 50.000 TL sermaye) veya anonim (AŞ - asgari 250.000 TL sermaye) şirketlerin tescil tüzüğü, geçici vergi kimlik numaraları, yasal banka blokajları ve Ticaret Sicili tescil işlemlerinin idari koordinasyonu.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">3. Yatırım Yeri ve İzin Süreçleri</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
              Organize Sanayi Bölgeleri (OSB), endüstri bölgeleri ve serbest bölgelerde sanayi arazisi tahsisi, imar izinleri, belediye ruhsat koordinasyon işlemlerinin yürütülmesi ve ÇED izin protokollerinin idari sevk takibi.
            </p>
          </div>

          <!-- Column 2: Incentive Scoping & Partner Relocation -->
          <div class="ledger-col">
            <span class="sec-number">BÖLÜM 02</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: var(--space-sm);">Teşvik, İzinler ve Yasal Uyum</h3>
            
            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-top: 15px; margin-bottom: var(--space-xs);">4. Teşvik Uygunluğu Ön Değerlendirmesi</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Yatırım projelerinin Sanayi Bakanlığı teşvik mevzuatına (YTB) uygunluğunun ön analizi, bölgesel/sektörel hibe simülasyonları ve asgari yatırım tutarlarının (2026 limitleri) ön denetimi.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">5. Oturum, Çalışma İzni ve Vatandaşlık Süreçleri</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 15px;">
              Yabancı ortaklar, expat yöneticiler ve teknik personelin resmi oturum, Çalışma Bakanlığı nezdinde çalışma izinleri ve vatandaşlık süreçlerinin kayıtlı dış hukuk partnerlerimizin eşgüdümünde yönetilmesi.
            </p>

            <h4 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: var(--space-xs);">6. Vergi, Muhasebe ve Hukuki Uyum Koordinasyonu</h4>
            <p style="font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 0;">
              Çifte vergilendirmeyi önleme anlaşmaları, KVKK/GDPR ticari uyumlulukları ve yerel muhasebe altyapılarının entegrasyonu süreçlerinin kayıtlı mali müşavirlik partnerlerimiz ile yürütülmesi.
            </p>
          </div>

        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <!-- Informational Boundaries Disclaimer -->
        <div class="boundaries-banner">
          <span class="boundaries-stamp">[ İDARİ UYARI VE PROTOKOL SINIRLANDIRMALARI ]</span>
          <p class="boundaries-text">
            <strong>B2B Danışmanlık ve Güvenli Koordinasyon:</strong> Mentor Group, doğrudan bir hukuk bürosu veya yeminli mali müşavirlik firması değildir. Türkiye Cumhuriyeti sınırları içerisindeki tüm dava, yasal temsil, resmi muhasebe denetimi ve vatandaşlık hukuku süreçleri; tescilli kanunlara uygun olarak, barolara ve ilgili odalara kayıtlı, <strong>kayıtlı hukuk ve mali müşavirlik partnerleri</strong> üzerinden koordine edilmektedir. Firmamız, yatırımcının idari süreç yönetimini ve stratejik pazar giriş planlamasını üstlenir. Yatırım süreçlerinde ilgili kamu kurumları, yatırım ofisi kaynakları, yerel idareler, OSB/serbest bölge yönetimleri ve kayıtlı uzman hizmet sağlayıcılarla koordinasyon sağlarız.
          </p>
        </div>

        <div class="double-rule" style="margin: 25px 0;"></div>

        <div class="text-center" style="margin-top: 25px;">
          <h4 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: var(--space-xs);">Türkiye Yatırım ve Yerleşim Planınızı Netleştirin</h4>
          <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: var(--space-md);">Pazara giriş stratejinizi, şirket tescil takvimini ve idari gereksinimleri 30 dakikalık resmî oturumda netleştirmek üzere randevunuzu oluşturun.</p>
          <a href="/tr/advisory/" class="btn btn-primary">İLK DEĞERLENDİRME RANDEVUSU AL</a>
        </div>
      </div>
      
    </div>
  </section>

</Layout>
