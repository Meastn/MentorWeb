  }

  .w-step-divider {
    color: var(--color-line-muted);
  }

  .wizard-panel {
    display: none;
    padding: var(--space-lg) 0;
  }

  .wizard-panel.active {
    display: block;
  }

  /* File upload stylized box */
  .file-upload-box {
    border: 1px dashed var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: var(--transition-fast);
  }

  .file-upload-box:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-paper);
  }

  .file-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 6px;
  }

  .file-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  /* AI Output briefing styled ledger folder */
  .ai-brief-dossier {
    border: 1px solid var(--color-line-muted);
    background-color: #1b1d1c;
    color: #FAF7F2;
    padding: var(--space-xl);
    font-family: monospace;
    font-size: 0.8rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    min-height: 250px;
    white-space: pre-line;
  }

  .typing-placeholder {
    color: var(--color-gold);
    text-align: center;
    padding-top: 50px;
    animation: flash 1s infinite alternate;
  }

  @keyframes flash {
    0% { opacity: 0.2; }
    100% { opacity: 1; }
  }

  /* Stripe box layout styling */
  .stripe-mock-box {
    max-width: 480px;
    margin: 0 auto;
    border: 1px solid #e6ebf1;
    border-radius: 4px;
    box-shadow: 0 15px 35px rgba(50,50,93,.1), 0 5px 15px rgba(0,0,0,.07);
    background-color: #f8f9fa;
  }

  .stripe-header {
    background-color: #635bff;
    color: white;
    padding: var(--space-md);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
  }

  .stripe-body {
    padding: var(--space-xl);
    background-color: white;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .stripe-price-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #32325d;
    margin-top: 6px;
  }

  .stripe-item-name {
    font-weight: 500;
    max-width: 70%;
  }

  .stripe-price {
    font-weight: bold;
  }

  .stripe-card-inputs {
    border: 1px solid #e6ebf1;
    padding: var(--space-md);
    background-color: #fcfcfc;
  }

  /* Google Calendar scheduling grid setup */
  .calendar-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
  }

  @media (min-width: 768px) {
    .calendar-layout-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .days-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .day-select-btn {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-sm);
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .day-select-btn.active, .day-select-btn:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-card);
    font-weight: 600;
  }

  .slots-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .slot-select-btn {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    padding: var(--space-sm);
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .slot-select-btn.active, .slot-select-btn:hover {
    background-color: var(--color-primary-green);
    color: var(--color-bg-paper);
    border-color: var(--color-primary-green);
    font-weight: 600;
  }

  /* Print Out receipt styling */
  .success-receipt-box {
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
  }

  .receipt-border-top {
    height: 6px;
    background-color: var(--color-primary-green);
  }

  .receipt-body {
    padding: var(--space-xl);
  }

  .receipt-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    border: 1px solid var(--color-line-muted);
    font-family: monospace;
    font-size: 0.85rem;
  }

  .receipt-row-data {
    border-bottom: 1px dashed var(--color-line-muted);
    padding-bottom: 6px;
  }

  .receipt-row-data:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .boundaries-banner {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-md);
    border-left: 3px solid var(--color-burgundy);
  }

  .boundaries-stamp {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }

  .boundaries-text {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
</style>

<script is:inline>
  // Complete client-side interactive wizard scripting
  const wizard = document.getElementById('advisory-flow-wizard');
  
  if (wizard) {
    const panels = wizard.querySelectorAll('.wizard-panel');
    const steps = wizard.querySelectorAll('.w-step');
    const form = wizard.querySelector('#intake-form');
    
    // Panel handles
    const panelForm = wizard.querySelector('#wizard-panel-form');
    const panelSummary = wizard.querySelector('#wizard-panel-summary');
    const panelStripe = wizard.querySelector('#wizard-panel-stripe');
    const panelCalendar = wizard.querySelector('#wizard-panel-calendar');
    const panelSuccess = wizard.querySelector('#wizard-panel-success');
    
    // Flow values stored
    let userName = "";
    let selectedDay = "01 Haz 2026";
    let selectedTime = "";

    const setStepActive = (stepName) => {
      steps.forEach(st => {
        if (st.getAttribute('data-nav') === stepName) {
          st.classList.add('active');
        } else {
          st.classList.remove('active');
        }
      });

      panels.forEach(pn => {
        pn.classList.remove('active');
      });
    };

    // Stage 1: Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Save user name
        const nameInput = document.getElementById('full_name');
        userName = nameInput ? nameInput.value : "Değerli Müşteri";
        
        // Move to Stage 2 (AI summary loading)
        setStepActive('summary');
        panelSummary.classList.add('active');
        
        // Execute simulated Case Intake Agent Typewriter summary
        const aiBriefOutput = document.getElementById('ai-brief-output');
        const nextActions = document.getElementById('ai-next-actions');
        
        if (aiBriefOutput) {
          const mainTopic = document.getElementById('main_topic').value;
          const sector = document.getElementById('sector').value;
          const desc = document.getElementById('case_detail').value;
          
          let topicCategory = "YATIRIM TEŞVİK BELGESİ BAŞVURUSU";
          let serviceFit = "Yatırım Teşvik Belgeleri Danışmanlık Departmanı";
          
          if (mainTopic === 'formation') {
            topicCategory = "ŞİRKET TESCİLİ VE KURULUMU";
            serviceFit = "Türkiye Pazar Giriş ve Kurulum Departmanı";
          } else if (mainTopic === 'relocate') {
            topicCategory = "YABANCI YATIRIM VE YERLEŞİM KOORDİNASYONU";
            serviceFit = "Invest & Relocate Koordinasyon Grubu";
          } else if (mainTopic === 'compliance') {
            topicCategory = "MEVZUAT UYUMLULUK VE LİSANS DENETİMİ";
            serviceFit = "Regülasyon ve Mevzuat Uyum Ekibi";
          }

          const summaryText = `[ CASE INTAKE ANALYTICAL DOSSIER BRIEF ]
          REF-ID: MG-REQ-${Date.now().toString().slice(-6)}-A
          --------------------------------------------------
          01. MÜŞTERİ PROFİLİ: ${userName}
          02. HEDEF SEKTÖR: ${sector.toUpperCase()}
          03. KATEGORİ: ${topicCategory}
          04. YATIRIM NİYETİ: ${desc.slice(0, 120)}...
          05. UYGUN HİZMET MODELİ: ${serviceFit}
          --------------------------------------------------
          [ SUGGESTED MEETING AGENDA / GÖRÜŞME GÜNDEMİ ]
          1. Yatırımcının yasal tescil ve asgari bütçe limitlerinin (YTB için 1.5M - 3M TL) değerlendirilmesi.
          2. Teşvik Bölgeleri Haritası (1-6. Bölge) avantajlarının sektörel analizi.
          3. Resmi başvuru öncesi gerekli evrak listesi ve bürokratik engellerin tespiti.
          --------------------------------------------------
          [ SECURITY RISK NOTES / RİSK NOTLARI ]
          - İdari onaylar Sanayi Bakanlığı yetkisindedir; garantörlük verilemez.
          - Yabancı ortaklıklarda banka blokaj ve MERSİS tescil süreleri dikkate alınmalıdır.
          - Rapor kilitlendi. Uyum Görüşmesi için harç ödemesi bekleniyor.`;

          let i = 0;
          aiBriefOutput.innerHTML = "";
          
          const typeWriter = () => {
            if (i < summaryText.length) {
              aiBriefOutput.innerHTML += summaryText.charAt(i);
              i++;
              setTimeout(typeWriter, 5); // Fast typewriter speed
            } else {
              if (nextActions) nextActions.style.display = "block";
            }
          };
          
          setTimeout(typeWriter, 800);
        }
      });
    }

    // Stage 2: Proceed to Stripe Mock
    const toStripeBtn = document.getElementById('ai-to-stripe-btn');
    if (toStripeBtn) {
      toStripeBtn.addEventListener('click', () => {
        setStepActive('stripe');
        panelStripe.classList.add('active');
      });
    }

    // Stage 3: Stripe Pay Button
    const payBtn = document.getElementById('stripe-pay-btn');
    if (payBtn) {
      payBtn.addEventListener('click', () => {
        payBtn.innerHTML = "ÖDEME ONAYLANIYOR...";
        payBtn.disabled = true;
        
        setTimeout(() => {
          setStepActive('calendar');
          panelCalendar.classList.add('active');
        }, 1500);
      });
    }

    // Stage 4: Google Calendar interactions
    const dayBtns = wizard.querySelectorAll('.day-select-btn');
    const slotBtns = wizard.querySelectorAll('.slot-select-btn');
    const confirmBtn = document.getElementById('confirm-booking-btn');

    dayBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        dayBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedDay = btn.getAttribute('data-day') || "01 Haz 2026";
      });
    });

    slotBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        slotBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedTime = btn.getAttribute('data-time') || "";
        if (confirmBtn) confirmBtn.style.display = "inline-block";
      });
    });

    // Stage 5: Final Confirmation receipt printout
    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        setStepActive('success');
        panelCalendar.classList.remove('active');
        panelSuccess.classList.add('active');
        
        // Update Receipt fields dynamically
        const rName = document.getElementById('r-name');
        const rRef = document.getElementById('r-ref');
        const rDatetime = document.getElementById('r-datetime');
        
        if (rName) rName.textContent = userName;
        if (rRef) rRef.textContent = `MG-REQ-${Date.now().toString().slice(-6)}-A`;
        if (rDatetime) rDatetime.textContent = `${selectedDay} | ${selectedTime} (TR Saati)`;
      });
    }
  }
</script>
