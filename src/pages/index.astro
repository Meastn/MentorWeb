---
/* REF: MG-2026-ASTRO-INDEX-REDIRECT-02 */
---
<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <title>Mentor Group Advisory</title>
    <!-- Server/Static Redirect Fallback (defaults to Turkish for SEO crawling) -->
    <meta http-equiv="refresh" content="0;url=/tr/" />
    <link rel="canonical" href="https://www.mentorgroup.com.tr/tr/" />
    <meta name="robots" content="noindex, follow" />
    
    <script is:inline>
      (async function() {
        try {
          const userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          
          // 1. If browser preference is Turkish, immediately redirect to /tr/ (0ms latency, no fetch required)
          if (userLang.startsWith('tr')) {
            window.location.replace('/tr/');
            return;
          }
          
          // 2. For non-Turkish browsers, run a fast GeoIP check to see if the IP is in Turkey
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 600); // Strict 600ms timeout for absolute speed
          
          try {
            const res = await fetch('https://ipapi.co/country/', { signal: controller.signal });
            const country = (await res.text()).trim().toUpperCase();
            clearTimeout(timeoutId);
            
            if (country === 'TR') {
              window.location.replace('/tr/');
            } else {
              window.location.replace('/en/');
            }
          } catch (apiErr) {
            // 3. Fallback if API fails or times out: redirect to /en/ (since browser language is non-Turkish)
            window.location.replace('/en/');
          }
        } catch (e) {
          // Absolute fallback
          window.location.replace('/tr/');
        }
      })();
    </script>
  </head>
  <body style="background-color: #FAF7F2; display: none;">
    <!-- Keeps the screen perfectly clean and invisible during the millisecond redirection phase -->
  </body>
</html>
