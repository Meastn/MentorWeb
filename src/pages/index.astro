---
/* REF: MG-2026-ASTRO-INDEX-REDIRECT-04 */
---
<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mentor Group Advisory</title>
    <!-- Server/Static Redirect Fallback (defaults to Turkish for SEO crawling) -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/tr/" />
    </noscript>
    <link rel="canonical" href="https://www.mentorgroup.com.tr/tr/" />
    <meta name="robots" content="noindex, follow" />
    
    <script is:inline>
      (function() {
        try {
          // Instant synchronous browser language check (no third-party API risk, zero latency)
          const userLang = (navigator.language || navigator.userLanguage || 'tr').toLowerCase();
          if (userLang.startsWith('tr')) {
            window.location.replace('/tr/');
          } else {
            window.location.replace('/en/');
          }
        } catch (e) {
          window.location.replace('/tr/');
        }
      })();
    </script>
    <style>
      body {
        background-color: #FAF7F2;
        color: #1c2b21;
        font-family: 'Cormorant Garamond', serif, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
      }
      .redirect-container {
        text-align: center;
        max-width: 400px;
        padding: 40px;
        background: #faf7f2;
        border: 1px solid #1c2b21;
        box-shadow: 0 4px 20px rgba(28, 43, 33, 0.05);
      }
      .title {
        font-size: 1.5rem;
        margin-bottom: 20px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
      }
      .link-btn {
        color: #1c2b21;
        text-decoration: none;
        border: 1px solid #1c2b21;
        padding: 8px 16px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
      }
      .link-btn:hover {
        background: #1c2b21;
        color: #faf7f2;
      }
    </style>
  </head>
  <body>
    <div class="redirect-container">
      <div class="title">MENTOR GROUP</div>
      <p style="font-size: 0.95rem; font-style: italic; opacity: 0.8; margin: 0 0 20px 0;">
        Yönlendiriliyorsunuz... / Redirecting...
      </p>
      <div class="links">
        <a href="/tr/" class="link-btn">TÜRKÇE</a>
        <a href="/en/" class="link-btn">ENGLISH</a>
      </div>
    </div>
  </body>
</html>

