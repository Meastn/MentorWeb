---
/* REF: MG-2026-ASTRO-ASSISTANT-01 */

interface Props {
  locale?: 'tr' | 'en';
}

const { locale = 'tr' } = Astro.props;
const isEn = locale === 'en';

const translations = {
  secTitle: isEn ? 'REGULATORY KNOWLEDGE PANEL' : 'MEVZUAT BİLGİ PANELİ',
  refStamp: isEn ? 'TERM-REF: KP-2026-EN' : 'TERM-REF: BP-2026-TR',
  tagline: isEn 
    ? 'ADVISORY KNOWLEDGE FILE: Mentor Group Verified Information Base'
    : 'MEVZUAT BİLGİ DOSYASI: Mentor Group Doğrulanmış Bilgi Paneli',
  placeholder: isEn ? 'Enter your regulatory query...' : 'Mevzuat veya teşvik sorunuzu yazın...',
  submitBtn: isEn ? 'SEARCH KNOWLEDGE BASE' : 'BİLGİ PANELİNDE ARA',
  disclaimer: isEn
    ? 'COMPLIANCE AUDIT NOTICE: The provided brief is strictly informational and extracted from verified regulatory sources. No legal, fiscal, or citizenship guarantees are given. Complex dossiers require direct expert partner overview.'
    : 'DANIŞMA VE UYUM BEYANI: Sunulan veriler yalnızca genel bilgilendirme amaçlı olup, doğrulanmış mevzuat kaynaklarından derlenmiştir. Hukuki, vergisel ya da vatandaşlık hak kazanımı garantisi teşkil etmez. Karmaşık dosyaların nihai incelenmesi için uzman ortaklarımızın incelemesi zorunludur.',
  
  samplePromptsLabel: isEn ? 'Select Advisory Dossier Scope:' : 'Onaylı İnceleme Konuları:',
  
  samplePrompts: isEn
    ? [
        { q: 'What is the minimum capital for company formation?', a: 'Under the Turkish Commercial Code (TCC), the minimum capital for a Limited Liability Company (Limited Şirket) is 50,000 TRY, and for a Joint Stock Company (Anonim Şirket) is 250,000 TRY (500,000 TRY for non-public companies adopting the registered capital system). Higher levels are recommended for operational credibility and banking clearance. To schedule formal dossier preparation, please book our Initial Review.' },
        { q: 'What supports are included in the Investment Incentive Certificate?', a: 'The Investment Incentive Certificate (Yatırım Teşvik Belgesi) under the 9903 Decree offers tiered benefits based on location (Regions 1 to 6) and scope. Standard general incentives require minimum fixed investments of 15,100,000 TRY in Regions 1 & 2, and 7,500,000 TRY in Regions 3-6. Benefits include VAT exemption, Customs Duty exemption, corporate tax reduction, social security premium support (employer share), and interest rate support for loans. Precise incentive calculations require scoping. To proceed, book our Initial Review.' },
        { q: 'Can you guarantee residence permits or citizenship approvals?', a: 'No. Mentor Group explicitly avoids guaranteeing any administrative, residency, or citizenship approvals. All relocation and citizenship applications undergo strict sovereign review by Turkish ministries. Mentor Group assists in organizing corporate dossiers and coordinating legal representation through registered partners. Book an Initial Review to clarify documents.' }
      ]
    : [
        { q: 'Yatırım Teşvik Belgesi başvurusu için asgari yatırım tutarı nedir?', a: '1/1/2026 itibarıyla Yatırım Teşvik Belgesi (YTB) kapsamında asgari sabit yatırım tutarı 1. ve 2. bölgelerde 15.100.000 TL, 3., 4., 5. ve 6. bölgelerde ise 7.500.000 TL’dir. Finansal kiralamada asgari tutar 3.800.000 TL, Stratejik Hamle yüksek teknolojili yatırımlarda ise asgari 125.000.000 TL’dir. Yatırım konusu, bölge, sektör ve destek sınıfına göre ek şartlar aranabilir. Şirketinizin uygunluk analizini yapmak üzere "İlk Değerlendirme Randevusu" almanızı öneririz.' },
        { q: 'Yabancı yatırımcılar Türkiye’de doğrudan şirket kurabilir mi?', a: 'Evet. Türkiye’deki Doğrudan Yabancı Yatırımlar Kanunu uyarınca, yabancı yatırımcılar yerli yatırımcılarla aynı haklara sahiptir ve %100 yabancı sermayeli limited veya anonim şirket kurabilirler. 2026 itibarıyla Limited şirketler için asgari sermaye 50.000 TL, Anonim şirketler için 250.000 TL’dir. Kuruluş süreci vergi kimlik numarası alımı, şirket ana sözleşmesinin MERSİS üzerinden tescili ve banka hesabı blokaj işlemlerini kapsar. Detaylı planlama için danışmanlık talep edebilirsiniz.' },
        { q: 'Devlet desteklerinde kesin hak kazanım garantisi veriliyor mu?', a: 'Hayır. Mentor Group, hiçbir devlet desteği, hibe veya teşvik başvurusunda nihai onay garantisi taahhüt etmez. Tüm onaylar T.C. Sanayi ve Teknoloji Bakanlığı ile ilgili yetkili kurumların münhasır yetkisindedir. Mentor Group, dosyanın mevzuata tam uyumlu hazırlanmasını ve idari takip sürecini üstlenir. İlk Değerlendirme Randevusu alarak riskleri inceleyebilirsiniz.' }
      ],
  
  ctaBtnLabel: isEn ? 'BOOK INITIAL REVIEW' : 'DEĞERLENDİRME RANDEVUSU AL'
};
---

<div class="advisory-assistant-card" data-locale={locale}>
  <div class="card-header">
    <span class="ref-stamp">{translations.refStamp}</span>
    <span class="classification">[ {translations.secTitle} ]</span>
  </div>

  <div class="card-body">
    <p class="tagline-bar">{translations.tagline}</p>

    <!-- Query Inputs -->
    <div class="query-area">
      <div class="prompt-chips">
        <span class="chips-label">{translations.samplePromptsLabel}</span>
        <div class="chips-flex">
          {translations.samplePrompts.map((prompt, idx) => (
            <button type="button" class="prompt-chip" data-idx={idx}>
              {prompt.q}
            </button>
          ))}
        </div>
      </div>

      <!-- Output Screen -->
      <div class="assistant-terminal">
        <div class="terminal-header">
          <span>{isEn ? 'KNOWLEDGE PANEL ACTIVE' : 'BİLGİ PANELİ AKTİF'}</span>
          <span class="pulse-dot"></span>
        </div>
        <div class="terminal-body" id="terminal-output">
          <p class="initial-msg">
            {isEn ? '> Knowledge panel ready. Select an advisory topic above or search for quick regulatory reference.' : '> Bilgi paneli hazır. Mevzuat özetlerini ve süreç adımlarını görüntülemek için yukarıdan bir inceleme konusu seçin.'}
          </p>
        </div>
      </div>

      <form class="terminal-input-bar" id="assistant-form">
        <input type="text" id="assistant-input" class="form-control" placeholder={translations.placeholder} required />
        <button type="submit" class="btn btn-primary">{translations.submitBtn}</button>
      </form>
    </div>

    <!-- Boundaries Banner -->
    <div class="boundaries-banner">
      <span class="boundaries-stamp">{isEn ? '[ ADVISORY SCOPE ]' : '[ HİZMET KAPSAMI ]'}</span>
      <p class="boundaries-text">{translations.disclaimer}</p>
      <div class="text-center" style="margin-top: 15px;">
        <a href={`${isEn ? '/en' : '/tr'}/advisory/`} class="btn btn-burgundy" style="font-size: 0.8rem; letter-spacing: 0.05em;">{translations.ctaBtnLabel}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .advisory-assistant-card {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    border-radius: var(--border-radius-sharp);
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .card-header {
    border-bottom: 1px solid var(--color-line-muted);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-bg-card);
  }

  .classification {
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .card-body {
    padding: var(--space-xl);
  }

  .tagline-bar {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-card);
    padding: 6px 12px;
    border-left: 2px solid var(--color-primary-green);
    margin-bottom: var(--space-lg);
    letter-spacing: 0.02em;
  }

  .prompt-chips {
    margin-bottom: var(--space-lg);
  }

  .chips-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .chips-flex {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .prompt-chip {
    background-color: transparent;
    border: 1px solid var(--color-line-muted);
    color: var(--color-text-ink);
    padding: 6px 12px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-align: left;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .prompt-chip:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-card);
  }

  /* Screen terminal layout */
  .assistant-terminal {
    border: 1px solid var(--color-line-muted);
    background-color: #1b1d1c;
    color: #FAF7F2;
    font-family: monospace;
    margin-bottom: var(--space-md);
  }

  .terminal-header {
    background-color: #272928;
    padding: 6px 12px;
    font-size: 0.65rem;
    color: #a0a5a2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #3c3f3d;
    letter-spacing: 0.05em;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #2e8b57;
    border-radius: 50%;
    box-shadow: 0 0 4px #2e8b57;
    display: inline-block;
  }

  .terminal-body {
    padding: var(--space-md);
    min-height: 150px;
    max-height: 250px;
    overflow-y: auto;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .terminal-query {
    color: var(--color-gold);
    margin-bottom: var(--space-xs);
    font-weight: bold;
  }

  .terminal-answer {
    color: #FAF7F2;
    margin-bottom: var(--space-md);
    border-left: 1px solid #5e1f27;
    padding-left: var(--space-sm);
  }

  .terminal-input-bar {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .terminal-input-bar input {
    background-color: var(--color-bg-paper);
    color: var(--color-text-ink);
  }

  /* Boundary banner */
  .boundaries-banner {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    border-left: 3px solid var(--color-burgundy);
  }

  .boundaries-stamp {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .boundaries-text {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .terminal-input-bar {
      flex-direction: column;
    }
    .terminal-input-bar button {
      width: 100%;
    }
  }
</style>

<script is:inline>
  // Access data collections in an embedded script tag to prevent complex client parsing issues
  const cards = document.querySelectorAll('.advisory-assistant-card');
  
  cards.forEach(card => {
    const locale = card.getAttribute('data-locale') || 'tr';
    const isEnglish = locale === 'en';
    
    const samplePrompts = isEnglish 
      ? [
          { q: 'What is the minimum capital for company formation?', a: 'Under the Turkish Commercial Code (TCC), the minimum capital for a Limited Liability Company (Limited Şirket) is 50,000 TRY, and for a Joint Stock Company (Anonim Şirket) is 250,000 TRY (500,000 TRY for non-public companies adopting the registered capital system). Higher levels are recommended for operational credibility and banking clearance. To schedule formal dossier preparation, please book our Initial Advisory Session.' },
          { q: 'What supports are included in the Investment Incentive Certificate?', a: 'The Investment Incentive Certificate (Yatırım Teşvik Belgesi) under the 9903 Decree offers tiered benefits based on location (Regions 1 to 6) and scope. Standard general incentives require minimum fixed investments of 15,100,000 TRY in Regions 1 & 2, and 7,500,000 TRY in Regions 3-6. Benefits include VAT exemption, Customs Duty exemption, corporate tax reduction, social security premium support (employer share), and interest rate support for loans. Precise incentive calculations require scoping. To proceed, book our Initial Advisory Session.' },
          { q: 'Can you guarantee residence permits or citizenship approvals?', a: 'No. Mentor Group explicitly avoids guaranteeing any administrative, residency, or citizenship approvals. All relocation and citizenship applications undergo strict sovereign review by Turkish ministries. Mentor Group assists in organizing corporate dossiers and coordinating legal representation through registered partners. Book an Initial Advisory Session to clarify documents.' }
        ]
      : [
          { q: 'Yatırım Teşvik Belgesi başvurusu için asgari yatırım tutarı nedir?', a: '1/1/2026 itibarıyla Yatırım Teşvik Belgesi (YTB) kapsamında asgari sabit yatırım tutarı 1. ve 2. bölgelerde 15.100.000 TL, 3., 4., 5. ve 6. bölgelerde ise 7.500.000 TL’dir. Finansal kiralamada asgari tutar 3.800.000 TL, Stratejik Hamle yüksek teknolojili yatırımlarda ise asgari 125.000.000 TL’dir. Yatırım konusu, bölge, sektör ve destek sınıfına göre ek şartlar aranabilir. Şirketinizin uygunluk analizini yapmak üzere "İlk Değerlendirme Randevusu" almanızı öneririz.' },
          { q: 'Yabancı yatırımcılar Türkiye’de doğrudan şirket kurabilir mi?', a: 'Evet. Türkiye’deki Doğrudan Yabancı Yatırımlar Kanunu uyarınca, yabancı yatırımcılar yerli yatırımcılarla aynı haklara sahiptir ve %100 yabancı sermayeli limited veya anonim şirket kurabilirler. 2026 itibarıyla Limited şirketler için asgari sermaye 50.000 TL, Anonim şirketler için 250.000 TL’dir. Kuruluş süreci vergi kimlik numarası alımı, şirket ana sözleşmesinin MERSİS üzerinden tescili ve banka hesabı blokaj işlemlerini kapsar. Detaylı planlama için danışmanlık talep edebilirsiniz.' },
          { q: 'Devlet desteklerinde kesin hak kazanım garantisi veriliyor mu?', a: 'Hayır. Mentor Group, hiçbir devlet desteği, hibe veya teşvik başvurusunda nihai onay garantisi taahhüt etmez. Tüm onaylar T.C. Sanayi ve Teknoloji Bakanlığı ile ilgili resmi kurumların münhasır yetkisindedir. Mentor Group, dosyanın mevzuata tam uyumlu hazırlanmasını ve idari takip sürecini üstlenir. İlk Değerlendirme Randevusu alarak riskleri inceleyebilirsiniz.' }
        ];

    const chips = card.querySelectorAll('.prompt-chip');
    const terminalOutput = card.querySelector('#terminal-output');
    const form = card.querySelector('#assistant-form');
    const input = card.querySelector('#assistant-input');

    const updateTerminal = (query, answer) => {
      if (terminalOutput) {
        terminalOutput.innerHTML = `
          <div class="terminal-query">> ${query}</div>
          <div class="terminal-answer">${answer}</div>
        `;
        terminalOutput.scrollTop = terminalOutput.scrollHeight;
      }
    };

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const idx = parseInt(chip.getAttribute('data-idx') || '0', 10);
        const data = samplePrompts[idx];
        if (data) {
          updateTerminal(data.q, data.a);
        }
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (input) {
          const val = input.value.trim();
          if (val) {
            const fallbackAns = isEnglish
              ? `Under advisory standards, the query [${val}] requires custom partner oversight to verify document parameters. Mentor Group does not provide automated legal or fiscal determinations. We advise booking the Initial Review.`
              : `Danışmanlık standartları ve mevzuat analizleri uyarınca, ilettiğiniz [${val}] sorusu uzmanlarımızın özel incelemesini gerektirmektedir. Mentor Group, otomatik hukuki ve mali uygunluk kararları sunmaz. "İlk Değerlendirme Randevusu" oluşturmanızı tavsiye ederiz.`;
            
            // Check if user input roughly matches keywords in sample
            let matched = false;
            for (let i = 0; i < samplePrompts.length; i++) {
              const kwList = samplePrompts[i].q.toLowerCase().split(' ');
              const matchCount = kwList.filter(kw => val.toLowerCase().includes(kw) && kw.length > 4).length;
              if (matchCount >= 2) {
                updateTerminal(val, samplePrompts[i].a);
                matched = true;
                break;
              }
            }

            if (!matched) {
              updateTerminal(val, fallbackAns);
            }
            input.value = '';
          }
        }
      });
    }
  });
</script>
