---
/* REF: MG-2026-ASTRO-ROUTEFINDER-02 */

interface Props {
  locale?: 'tr' | 'en';
}

const { locale = 'tr' } = Astro.props;
const isEn = locale === 'en';

const translations = {
  sectionTitle: isEn ? 'ROUTE FINDER DOSSIER' : 'YOL HARİTASI TESPİT DOSYASI',
  refStamp: isEn ? 'FORM-REF: RD-2026-EN-10' : 'FORM-REF: YD-2026-TR-10',
  introduction: isEn 
    ? 'Answer five structural regulatory questions to determine your appropriate path and preliminary advisory support.'
    : 'Yatırımınızın hukuki, mali ve teşviksel kapsamını belirlemek için aşağıdaki beş yapısal soruyu yanıtlayınız.',
  
  step1Title: isEn ? '01. Target Location & Incentive Region / Yatırım Bölgesi' : '01. Yatırım İli / Bölgesi Nedir?',
  step1Options: [
    { value: 'region_1_2', label: isEn ? 'Region 1 & 2 (e.g. Istanbul, Ankara, Izmir, Kocaeli, Bursa, Antalya)' : '1. ve 2. Bölge (Örn: İstanbul, Ankara, İzmir, Kocaeli, Bursa, Antalya...)' },
    { value: 'region_3_4', label: isEn ? 'Region 3 & 4 (e.g. Adana, Trabzon, Manisa, Gaziantep, Konya, Samsun)' : '3. ve 4. Bölge (Örn: Adana, Trabzon, Manisa, Gaziantep, Konya, Samsun...)' },
    { value: 'region_5_6', label: isEn ? 'Region 5 & 6 (e.g. Sanliurfa, Diyarbakir, Van, Kars, Kahramanmaras, Bingol)' : '5. ve 6. Bölge (Örn: Şanlıurfa, Diyarbakır, Van, Kars, Kahramanmaraş, Bingöl...)' }
  ],

  step2Title: isEn ? '02. Investment Volume & Statutory Thresholds / Yatırım Tutarı' : '02. Yatırım Tutarı Yasal Limitlerin Üzerinde mi?',
  step2Options: [
    { value: 'above_threshold', label: isEn ? 'ABOVE the 2026 minimum threshold (15.1M TRY for Reg 1-2 / 7.5M TRY for Reg 3-6)' : 'EVET, asgari sınırın ÜZERİNDE (1. ve 2. Bölgeler için 15,1 Milyon TL; diğer bölgeler için 7,5 Milyon TL)' },
    { value: 'below_threshold', label: isEn ? 'BELOW the 2026 minimum threshold (Under 15.1M / 7.5M TRY)' : 'HAYIR, asgari sınırın ALTINDA (15,1 Milyon TL veya 7,5 Milyon TL altı)' }
  ],

  step3Title: isEn ? '03. Investment Sector & Subject / Yatırım Konusu' : '03. Yatırım Konusu Nedir?',
  step3Options: [
    { value: 'eligible_sectors', label: isEn ? 'Manufacturing, High Tech, Energy, Data Center, Green/Digital, Services' : 'İmalat, Yüksek Teknoloji, Enerji, Veri Merkezi, Yeşil/Dijital Dönüşüm veya Hizmet Sektörü' },
    { value: 'other_sectors', label: isEn ? 'Traditional Agriculture, Real Estate, Local Retail, or Non-eligible sectors' : 'Geleneksel Tarım, Gayrimenkul, Yerel Perakende veya Teşvik Dışı Diğer Sektörler' }
  ],

  step4Title: isEn ? '04. Project Modification Type / Yatırım Türü' : '04. Yatırımın Türü Nedir?',
  step4Options: [
    { value: 'yeni', label: isEn ? 'Greenfield / Complete New Investment' : 'Komple Yeni Yatırım' },
    { value: 'tevsi', label: isEn ? 'Expansion / Capacity Increase (Tevsi)' : 'Tevsi Yatırımı (Kapasite Artırımı / Genişleme)' },
    { value: 'modernizasyon', label: isEn ? 'Modernization, Product Diversification, or Integration' : 'Modernizasyon, Ürün Çeşitlendirme veya Entegrasyon/Darboğaz Giderme' }
  ],

  step5Title: isEn ? '05. Strategic Development Focus / Kalkınma Hamlesi' : '05. Türkiye Yüzyılı Kalkınma Hamlesi Kapsamı',
  step5Options: [
    { value: 'hamle_eligible', label: isEn ? 'YES, qualifies as high tech or large scale strategic setup (above 125M / 251M TRY)' : 'EVET, yüksek teknolojili imalat veya büyük ölçekli stratejik yatırım (125 Milyon TL veya 251 Milyon TL üzeri)' },
    { value: 'hamle_not', label: isEn ? 'NO or Uncertain (We prefer general regional/sectoral incentives)' : 'HAYIR veya BELİRSİZ (Genel bölgesel ve sektörel teşvikler kapsamındayız)' }
  ],

  nextBtn: isEn ? 'PROCEED TO NEXT SECTION' : 'SONRAKİ BÖLÜME GEÇ',
  prevBtn: isEn ? 'PREVIOUS SECTION' : 'ÖNCEKİ BÖLÜM',
  evalBtn: isEn ? 'GENERATE ADVISORY SUMMARY' : 'ÖN DEĞERLENDİRME DOSYASINI OLUŞTUR',
  
  resultTitle: isEn ? 'PRELIMINARY ADVISORY ASSESSMENT' : 'ÖN DEĞERLENDİRME VE SÜREÇ ÖZETİ',
  resultReset: isEn ? 'RESET ASSESSMENT' : 'ÖN DEĞERLENDİRMEYİ YENİDEN BAŞLAT',
  
  incentiveRecTitle: isEn ? 'PATHWAY A: REGIONAL & SECTORAL INVESTMENT INCENTIVES' : 'ROTA A: SEKTÖREL VE BÖLGESEL YATIRIM TEŞVİK BELGESİ',
  incentiveRecDesc: isEn
    ? 'Based on your response, your project meets the statutory fixed-capital thresholds under 2026 guidelines (Decree No. 9903). You qualify for VAT exemption, Customs Duty waiver, corporate tax reductions, and SGK premium employer-share support. We recommend booking a structured Initial Review to map your 2025/1 Communiqué filing strategy.'
    : 'Yapmış olduğunuz beyana göre, planlanan faaliyetiniz 2026 yılı 9903 Sayılı Karar kapsamında Sektörel ve Bölgesel Yatırım Teşvik Belgesi kriterleriyle eşleşmektedir. Yatırımınız için KDV İstisnası, Gümrük Vergisi Muafiyeti, Kurumlar Vergisi İndirimi ve SGK İşveren Hissesi Desteği gibi haklar mevcuttur. Başvuru dosyasının 2025/1 Tebliği standartlarında hazırlanması için uzman kadromuzla "İlk Değerlendirme Randevusu" oluşturmanızı tavsiye ederiz.',
  
  strategicRecTitle: isEn ? 'PATHWAY B: STRATEGIC HAMLE & HIGH-TECH SUBSIDIES' : 'ROTA B: TÜRKİYE YÜZYILI KALKINMA HAMLESİ VE STRATEJİK DESTEKLER',
  strategicRecDesc: isEn
    ? 'Your project satisfies high capital density or high-tech parameters, making it an excellent candidate for the strategic "Türkiye Century Development Hamle" (Technology Hamle / Strategic Hamle) frameworks. Subsidies can exceed 125,000,000 TRY or 251,000,000 TRY and offer direct state grants. We advise scheduling an Initial Review for comprehensive ministry-level scoping.'
    : 'Projeniz, yüksek sermaye yoğunluğu veya yüksek teknolojik katma değeri sayesinde Türkiye Yüzyılı Kalkınma Hamlesi (Teknoloji Hamlesi / Stratejik Hamle) kapsamında değerlendirilmeye son derece uygundur. Bu kapsamdaki yatırımlar (125.000.000 TL ve 251.000.000 TL üzeri) çok özel ve yüksek oranlı muafiyetler ile devlet hibelerine hak kazanabilir. Dosyanızın resmen scoping analizi için başmüşavirimiz nezdinde "İlk Değerlendirme Randevusu" almanızı öneririz.',

  relocateRecTitle: isEn ? 'PATHWAY C: FOREIGN CAPITAL SETUP & COMPANY FORMATION' : 'ROTA C: YABANCI SERMAYE YATIRIMI VE ŞİRKET KURULUŞU',
  relocateRecDesc: isEn
    ? 'Your file requires specialized corporate structure setup in Türkiye (under TCC 2026 capital guidelines: 50,000 TRY for LLC / 250,000 TRY for JSC / 500,000 TRY for registered setups). We organize full market entry, bank onboarding, and legal compliance coordination in coordination with our registered partner networks. Book an Initial Review to secure your roadmap.'
    : 'Yatırımınız, Türkiye pazarında şirket kurulumu (50.000 TL Limited / 250.000 TL Anonim asgari sermaye limitleri), yerleşim/faaliyet izinleri ve idari süreç koordinasyonunu gerektirmektedir. Mentor Group, pazar girişinizi koordine etmek üzere kayıtlı hukuk ve mali müşavirlik partnerlerimizle birlikte özel bir yol haritası sunar. Başlamak için "İlk Değerlendirme Randevusu" alabilirsiniz.',

  belowRecTitle: isEn ? 'ADVISORY NOTICE: 2026 INVESTMENT THRESHOLD LIMITATIONS' : 'BİLGİLENDİRME: 2026 ASGARİ YATIRIM EŞİĞİ VE ALTERNATİF DESTEKLER',
  belowRecDesc: isEn
    ? 'Your planned investment is below the statutory 2026 general thresholds (15,100,000 TRY for Regions 1-2; 7,500,000 TRY for Regions 3-6). General YTB certificate tescil is unavailable. However, you can explore the 3,800,000 TRY leasing machinery track, KOSGEB regional programs, or TÜBİTAK R&D grants. Book an Initial Review to map these alternative micro-grants.'
    : 'Planlanan yatırım bütçeniz 2026 yılı yasal asgari sınırlarının (1. ve 2. bölgelerde 15.100.000 TL; diğer bölgelerde 7.500.000 TL) altında görünmektedir. Bu bütçe düzeyiyle genel veya bölgesel Yatırım Teşvik Belgesi (YTB) tescili mümkün değildir. Ancak, 3.800.000 TL leasing sınırı, KOSGEB destekleri, TÜBİTAK Ar-Ge hibeleri veya alternatif mikro-destek modelleri değerlendirilebilir. Yol haritanızı bu alternatiflere göre şekillendirmek için "İlk Değerlendirme Randevusu" alabilirsiniz.',

  readGuideBtn: isEn ? 'VIEW DETAILED SERVICE GUIDE' : 'HİZMET YOL HARİTASINI İNCELE',
  bookAdvisoryBtn: isEn ? 'BOOK INITIAL REVIEW' : 'İLK DEĞERLENDİRME RANDEVUSU AL',
  
  termsNotice: isEn 
    ? 'This tool provides automated preliminary routing based on standard criteria and does not constitute a formal binding legal, tax, or investment guarantee.'
    : 'Bu tespit aracı, standart kriterlere göre otomatik ön yönlendirme sağlamakta olup hiçbir şekilde resmi hukuki, mali ya da vergi garantisi veya kesin onay taahhüdü teşkil etmez.'
};
---

<div class="route-finder-card" data-locale={locale}>
  <div class="card-header">
    <span class="ref-stamp">{translations.refStamp}</span>
    <span class="classification">[ {translations.sectionTitle} ]</span>
  </div>

  <div class="card-body">
    <!-- Step 1 -->
    <div class="step-panel active" data-step="1">
      <p class="step-intro">{translations.introduction}</p>
      
      <h4 class="step-question">{translations.step1Title}</h4>
      <div class="radio-grid">
        {translations.step1Options.map((opt, i) => (
          <label class="radio-box">
            <input type="radio" name="location" value={opt.value} checked={i === 0} class="radio-input" />
            <span class="radio-custom"></span>
            <span class="radio-label">{opt.label}</span>
          </label>
        ))}
      </div>
      
      <div class="step-actions">
        <button type="button" class="btn btn-primary next-step-btn">{translations.nextBtn}</button>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="step-panel" data-step="2">
      <h4 class="step-question">{translations.step2Title}</h4>
      <div class="radio-grid">
        {translations.step2Options.map((opt, i) => (
          <label class="radio-box">
            <input type="radio" name="budget" value={opt.value} checked={i === 0} class="radio-input" />
            <span class="radio-custom"></span>
            <span class="radio-label">{opt.label}</span>
          </label>
        ))}
      </div>
      
      <div class="step-actions">
        <button type="button" class="btn btn-secondary prev-step-btn">{translations.prevBtn}</button>
        <button type="button" class="btn btn-primary next-step-btn">{translations.nextBtn}</button>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="step-panel" data-step="3">
      <h4 class="step-question">{translations.step3Title}</h4>
      <div class="radio-grid">
        {translations.step3Options.map((opt, i) => (
          <label class="radio-box">
            <input type="radio" name="sector" value={opt.value} checked={i === 0} class="radio-input" />
            <span class="radio-custom"></span>
            <span class="radio-label">{opt.label}</span>
          </label>
        ))}
      </div>
      
      <div class="step-actions">
        <button type="button" class="btn btn-secondary prev-step-btn">{translations.prevBtn}</button>
        <button type="button" class="btn btn-primary next-step-btn">{translations.nextBtn}</button>
      </div>
    </div>

    <!-- Step 4 -->
    <div class="step-panel" data-step="4">
      <h4 class="step-question">{translations.step4Title}</h4>
      <div class="radio-grid">
        {translations.step4Options.map((opt, i) => (
          <label class="radio-box">
            <input type="radio" name="type" value={opt.value} checked={i === 0} class="radio-input" />
            <span class="radio-custom"></span>
            <span class="radio-label">{opt.label}</span>
          </label>
        ))}
      </div>
      
      <div class="step-actions">
        <button type="button" class="btn btn-secondary prev-step-btn">{translations.prevBtn}</button>
        <button type="button" class="btn btn-primary next-step-btn">{translations.nextBtn}</button>
      </div>
    </div>

    <!-- Step 5 -->
    <div class="step-panel" data-step="5">
      <h4 class="step-question">{translations.step5Title}</h4>
      <div class="radio-grid">
        {translations.step5Options.map((opt, i) => (
          <label class="radio-box">
            <input type="radio" name="hamle" value={opt.value} checked={i === 1} class="radio-input" />
            <span class="radio-custom"></span>
            <span class="radio-label">{opt.label}</span>
          </label>
        ))}
      </div>
      
      <div class="step-actions">
        <button type="button" class="btn btn-secondary prev-step-btn">{translations.prevBtn}</button>
        <button type="button" class="btn btn-burgundy evaluate-btn">{translations.evalBtn}</button>
      </div>
    </div>

    <!-- Result panel -->
    <div class="step-panel result-panel" data-step="result">
      <div class="report-stamp">{isEn ? '[ PRELIMINARY ADVISORY NOTE ]' : '[ ÖN DEĞERLENDİRME NOTU ]'}</div>
      <h3 class="result-title">{translations.resultTitle}</h3>
      <div class="double-rule" style="margin: 15px 0;"></div>
      
      <!-- Dynamic Outcomes -->
      <div class="outcome-box incentives-outcome">
        <h4 class="outcome-header">{translations.incentiveRecTitle}</h4>
        <p class="outcome-text">{translations.incentiveRecDesc}</p>
        <div class="outcome-actions">
          <a href={`${isEn ? '/en' : '/tr'}/services/investment-incentives/`} class="btn btn-secondary">{translations.readGuideBtn}</a>
          <a href={`${isEn ? '/en' : '/tr'}/advisory/`} class="btn btn-primary">{translations.bookAdvisoryBtn}</a>
        </div>
      </div>

      <div class="outcome-box strategic-outcome">
        <h4 class="outcome-header">{translations.strategicRecTitle}</h4>
        <p class="outcome-text">{translations.strategicRecDesc}</p>
        <div class="outcome-actions">
          <a href={`${isEn ? '/en' : '/tr'}/services/investment-incentives/`} class="btn btn-secondary">{translations.readGuideBtn}</a>
          <a href={`${isEn ? '/en' : '/tr'}/advisory/`} class="btn btn-primary">{translations.bookAdvisoryBtn}</a>
        </div>
      </div>

      <div class="outcome-box relocate-outcome">
        <h4 class="outcome-header">{translations.relocateRecTitle}</h4>
        <p class="outcome-text">{translations.relocateRecDesc}</p>
        <div class="outcome-actions">
          <a href={`${isEn ? '/en' : '/tr'}/services/invest-relocate/`} class="btn btn-secondary">{translations.readGuideBtn}</a>
          <a href={`${isEn ? '/en' : '/tr'}/advisory/`} class="btn btn-primary">{translations.bookAdvisoryBtn}</a>
        </div>
      </div>

      <div class="outcome-box below-outcome">
        <h4 class="outcome-header">{translations.belowRecTitle}</h4>
        <p class="outcome-text">{translations.belowRecDesc}</p>
        <div class="outcome-actions">
          <a href={`${isEn ? '/en' : '/tr'}/services/investment-incentives/`} class="btn btn-secondary">{translations.readGuideBtn}</a>
          <a href={`${isEn ? '/en' : '/tr'}/advisory/`} class="btn btn-primary">{translations.bookAdvisoryBtn}</a>
        </div>
      </div>

      <p class="result-notice">{translations.termsNotice}</p>

      <div class="step-actions text-center" style="margin-top: 20px;">
        <button type="button" class="btn btn-secondary reset-btn" style="font-size: 0.75rem; padding: 6px 12px;">{translations.resultReset}</button>
      </div>
    </div>
  </div>
</div>

<style>
  .route-finder-card {
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-paper);
    border-radius: var(--border-radius-sharp);
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .card-header {
    border-bottom: 1px solid var(--color-line-muted);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-bg-card);
  }

  .classification {
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .card-body {
    padding: var(--space-xl);
  }

  .step-panel {
    display: none;
  }

  .step-panel.active {
    display: flex;
    flex-direction: column;
  }

  .step-intro {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-lg);
  }

  .step-question {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--color-text-ink);
  }

  .radio-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .radio-box {
    display: flex;
    align-items: flex-start;
    padding: var(--space-md);
    border: 1px solid var(--color-line-muted);
    background-color: var(--color-bg-card);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .radio-box:hover {
    border-color: var(--color-primary-green);
    background-color: var(--color-bg-paper);
  }

  .radio-input {
    margin-top: 3px;
    margin-right: var(--space-md);
    accent-color: var(--color-primary-green);
  }

  .radio-label {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-text-ink);
  }

  .step-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: flex-end;
  }

  /* Result report styling */
  .result-panel {
    text-align: left;
  }

  .report-stamp {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-burgundy);
    font-weight: bold;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .result-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0;
  }

  .outcome-box {
    display: none;
    border: 1px solid var(--color-line-muted);
    padding: var(--space-lg);
    background-color: var(--color-bg-card);
    margin-bottom: var(--space-md);
  }

  .outcome-box.active {
    display: block;
  }

  .outcome-header {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary-green);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .outcome-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-ink);
    margin-bottom: var(--space-md);
  }

  .outcome-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .result-notice {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    border-left: 2px solid var(--color-line-muted);
    padding-left: var(--space-sm);
    margin-top: var(--space-md);
  }

  @media (max-width: 600px) {
    .step-actions {
      flex-direction: column;
    }
    
    .step-actions .btn {
      width: 100%;
    }

    .outcome-actions {
      flex-direction: column;
    }

    .outcome-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Simple multi-step script scoped to RouteFinder
  const routeFinder = document.querySelector('.route-finder-card');
  if (routeFinder) {
    let currentStepIndex = 1;
    const panels = routeFinder.querySelectorAll('.step-panel');
    const nextBtns = routeFinder.querySelectorAll('.next-step-btn');
    const prevBtns = routeFinder.querySelectorAll('.prev-step-btn');
    const evalBtn = routeFinder.querySelector('.evaluate-btn');
    const resetBtn = routeFinder.querySelector('.reset-btn');

    const updateStep = (index: number | string) => {
      panels.forEach(panel => {
        const stepAttr = panel.getAttribute('data-step');
        if (stepAttr === String(index)) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    };

    nextBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentStepIndex++;
        updateStep(currentStepIndex);
      });
    });

    prevBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentStepIndex--;
        updateStep(currentStepIndex);
      });
    });

    if (evalBtn) {
      evalBtn.addEventListener('click', () => {
        // Collect choices
        const budgetInput = routeFinder.querySelector('input[name="budget"]:checked') as HTMLInputElement;
        const budget = budgetInput ? budgetInput.value : 'above_threshold';

        const sectorInput = routeFinder.querySelector('input[name="sector"]:checked') as HTMLInputElement;
        const sector = sectorInput ? sectorInput.value : 'eligible_sectors';

        const hamleInput = routeFinder.querySelector('input[name="hamle"]:checked') as HTMLInputElement;
        const hamle = hamleInput ? hamleInput.value : 'hamle_not';

        // Select correct report box
        const incentivesOutcome = routeFinder.querySelector('.incentives-outcome');
        const strategicOutcome = routeFinder.querySelector('.strategic-outcome');
        const relocateOutcome = routeFinder.querySelector('.relocate-outcome');
        const belowOutcome = routeFinder.querySelector('.below-outcome');

        // Hide all first
        incentivesOutcome?.classList.remove('active');
        strategicOutcome?.classList.remove('active');
        relocateOutcome?.classList.remove('active');
        belowOutcome?.classList.remove('active');

        if (budget === 'below_threshold') {
          belowOutcome?.classList.add('active');
        } else if (sector === 'other_sectors') {
          relocateOutcome?.classList.add('active');
        } else if (hamle === 'hamle_eligible') {
          strategicOutcome?.classList.add('active');
        } else {
          incentivesOutcome?.classList.add('active');
        }

        // Navigate to result panel
        updateStep('result');
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentStepIndex = 1;
        updateStep(1);
      });
    }
  }
</script>
